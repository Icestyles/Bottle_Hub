local LivePBState = nil
local function getLivePBState()
    if LivePBState and (LivePBState.defenseTiming or LivePBState.pixelQTE or LivePBState.warriorBladeTiming) then
        return LivePBState
    end
    if getconnections and RPGState and getupvalues then
        pcall(function()
            for _, conn in ipairs(getconnections(RPGState.OnClientEvent)) do
                local fn = conn.Function
                if fn then
                    local uvs = getupvalues(fn)
                    for _, uv in pairs(uvs) do
                        if type(uv) == "table" and (uv.defenseTiming or uv.warriorBladeTiming or uv.pixelQTE or uv.explorationPanels) then
                            LivePBState = uv
                            return
                        end
                    end
                end
            end
        end)
    end
    return LivePBState
end

-- Unified Active QTE Session Tracker
local ActiveQTESessions = {}

-- 📡 Real-Time SkillCheckPress Telemetry Streamer
-- Streams real-time telemetry packets to RPGCommand for each QTE round/sigil/mark.
-- Crucial: The server validates attacks by verifying that SkillCheckPress was received
-- for each round i matching the server time window. If absent, the server flags a MISS.
local function sendSkillCheckPress(battleId, token, roundIndex, startTime, pressTime)
    if not RPGCommand or not battleId or not token then return false end
    local ok = pcall(function()
        RPGCommand:FireServer("SkillCheckPress", {
            battleId = tostring(battleId),
            token = tostring(token),
            i = math.floor(tonumber(roundIndex) or 1),
            s = tonumber(startTime) or getServerTime(),
            at = tonumber(pressTime) or getServerTime(),
        })
    end)
    return ok
end

-- 🎯 Central Precision QTE Press Dispatcher
-- Primary: Triggers native activeQte:_press("key") so SkillCheckStream captures and streams
-- SkillCheckPress telemetry packets to the server in real-time (prevents anti-macro MISS penalty).
-- Fallback: Directly invokes pressHandler() if _press() is not implemented or blocked.
local function triggerPrecisionPress(activeQte, token)
    if not activeQte then return false end
    if token and activeQte.token and activeQte.token ~= token then return false end
    local handled = false

    -- 1. Primary: Native _press("key") triggers SkillCheckStream hook which streams SkillCheckPress to Server
    if type(activeQte._press) == "function" then
        local ok = pcall(function()
            activeQte:_press("key")
        end)
        if ok then handled = true end
    end

    -- 2. Fallback: Direct pressHandler invocation if _press failed, was blocked, or not available
    if not handled and type(activeQte.pressHandler) == "function" then
        local ok = pcall(activeQte.pressHandler)
        if ok then handled = true end
    end

    return handled
end

local function solveDefenseQTE(qteSelf, data)
    if not CombatConfig.AutoQTE_Defense or type(data) ~= "table" then return end
    local token = tostring(data.token or "")
    if token == "" then return end

    local session = ActiveQTESessions[token]
    if session then
        if qteSelf then session.qteSelf = qteSelf end
        return
    end

    session = {
        token = token,
        qteSelf = qteSelf,
        resolved = false,
        sentPresses = {},
        startedAt = os.clock(),
    }
    ActiveQTESessions[token] = session

    local duration = tonumber(data.duration) or 0.85
    local target = tonumber(data.target) or 0.5
    local startedAt = tonumber(data.startedAt) or getServerTime()
    local targetOffset = target * duration
    local targetTimestamp = startedAt + targetOffset

    -- Humanize Micro-Jitter: 5ms - 10ms (0.005s to 0.010s)
    local jitter = 0.005 + (math.random() * 0.005)
    local triggerTimestamp = targetTimestamp + jitter

    task.spawn(function()
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local now = getServerTime()
            if now >= triggerTimestamp then
                if session.resolved then
                    if conn and conn.Connected then conn:Disconnect() end
                    return
                end
                session.resolved = true
                if conn and conn.Connected then conn:Disconnect() end

                -- Layer 1: Native In-Memory Driver via _press("key") (Streams SkillCheckPress + triggers UI)
                local nativeHandled = false
                local activeQte = session.qteSelf or (LivePBState and LivePBState.pixelQTE)
                if activeQte and activeQte.token == token then
                    nativeHandled = triggerPrecisionPress(activeQte, token)
                end

                -- Layer 2: Direct Network Dispatch (Fail-Safe if native UI is inactive/headless)
                if not nativeHandled and RPGCommand then
                    pcall(function()
                        RPGCommand:FireServer("DefenseTimingInput", {
                            battleId = data.battleId,
                            token = token,
                            pressedAt = triggerTimestamp
                        })
                    end)
                end

                -- Client UI Sync (Update UI rings & mark sent to avoid conflicts)
                local pbState = getLivePBState()
                local clientObj = (session.qteSelf and session.qteSelf.pending and session.qteSelf) or (pbState and pbState.defenseTiming)
                if clientObj and clientObj.pending and clientObj.pending.token == token and not clientObj.sent then
                    pcall(function()
                        clientObj.sent = true
                        if clientObj.key then clientObj.key.Text = "·" end
                        if clientObj.help then clientObj.help.Text = "" end
                    end)
                end
            end
        end)

        -- Safety cleanup after duration + 1.2s
        task.delay(duration + 1.2, function()
            if conn and conn.Connected then
                conn:Disconnect()
            end
            ActiveQTESessions[token] = nil
        end)
    end)
end

local function solveWarriorQTE(qteSelf, data)
    if not CombatConfig.AutoQTE_Attack or type(data) ~= "table" then return end
    local token = tostring(data.token or "")
    if token == "" then return end

    local session = ActiveQTESessions[token]
    if session then
        if qteSelf then session.qteSelf = qteSelf end
        return
    end

    session = {
        token = token,
        qteSelf = qteSelf,
        resolved = false,
        sentPresses = {},
        startedAt = os.clock(),
    }
    ActiveQTESessions[token] = session

    local battleId = data.battleId
    local rounds = type(data.rounds) == "table" and data.rounds or {}
    if #rounds == 0 then
        rounds = { { targetPosition = 0.5, sweepSeconds = 1, goodWindow = 0.12, perfectWindow = 0.045 } }
    end

    task.spawn(function()
        for i, round in ipairs(rounds) do
            if session.resolved then break end

            local roundStart = getServerTime()
            local targetPos = tonumber(round.targetPosition) or 0.5
            local sweepSec = tonumber(round.sweepSeconds) or 1
            -- Handle reverse blade sweep (1 -> 0): blade reaches target at (1 - targetPos) * sweepSec
            local effectiveTarget = (round.reverse == true) and (1 - targetPos) or targetPos
            local waitTime = effectiveTarget * sweepSec
            -- Humanized micro-jitter: 5ms - 10ms (0.005s <= jitter <= 0.010s)
            local jitter = 0.005 + (math.random() * 0.005)

            -- 🎯 Clamp min wait to 0.26s so PixelQTE:_press passes the openedAt + 0.25 anti-spam window!
            task.wait(math.clamp(waitTime + jitter, 0.26, 1.5))

            local pressTime = getServerTime()

            -- 1. Stream real-time SkillCheckPress packet to Server (prevents anti-macro MISS penalty)
            if not session.sentPresses[i] then
                session.sentPresses[i] = true
                sendSkillCheckPress(battleId, token, i, roundStart, pressTime)
            end

            -- 2. Native In-Memory Driver: Trigger PixelQTE visual feedback & animations
            local activeQte = session.qteSelf or (LivePBState and LivePBState.pixelQTE)
            if activeQte and activeQte.token == token then
                local pressed = triggerPrecisionPress(activeQte, token)
                if not pressed and type(activeQte._completeTrace) == "function" then
                    pcall(activeQte._completeTrace, activeQte)
                end
            end

            -- Transition interval between rounds in PixelQTE is 0.32s
            if i < #rounds then
                task.wait(0.32 + (math.random() * 0.02))
            end
        end

        -- Completion Dispatch: Wait 0.15s after final sweep, then fire WarriorBladeTimingResult
        task.wait(0.15)
        if not session.resolved and RPGCommand and token ~= "" then
            session.resolved = true
            local results = {}
            for i, round in ipairs(rounds) do
                local targetPos = tonumber(round.targetPosition) or 0.5
                local jitterOffset = (0.005 + math.random() * 0.005) * 0.5
                results[i] = {
                    pressed = true,
                    position = math.clamp(targetPos + jitterOffset, 0, 1)
                }
            end
            pcall(function()
                RPGCommand:FireServer("WarriorBladeTimingResult", {
                    battleId = tostring(battleId or ""),
                    token = token,
                    results = results
                })
            end)
        end

        task.delay(1.5, function()
            ActiveQTESessions[token] = nil
        end)
    end)
end

local function solveThiefQTE(qteSelf, data)
    if not CombatConfig.AutoQTE_Attack or type(data) ~= "table" then return end
    local token = tostring(data.token or "")
    if token == "" then return end

    local session = ActiveQTESessions[token]
    if session then
        if qteSelf then session.qteSelf = qteSelf end
        return
    end

    session = {
        token = token,
        qteSelf = qteSelf,
        resolved = false,
        sentPresses = {},
        startedAt = os.clock(),
    }
    ActiveQTESessions[token] = session

    local battleId = data.battleId
    local targets = type(data.targets) == "table" and data.targets or {}
    local marks = type(data.marks) == "table" and data.marks or {}
    local maxHits = tonumber(data.maximumHits)
    local totalHits = maxHits or (#targets > 0 and #targets) or (#marks > 0 and #marks) or 1
    local hitCount = math.clamp(math.floor(totalHits), 1, 8)

    local targetSec = math.clamp(tonumber(data.targetSeconds) or tonumber(data.duration) or 0.78, 0.15, 1.5)
    local openFrom = math.clamp(tonumber(data.openFrom) or 0.35, 0, 1)
    local openTo = math.clamp(tonumber(data.openTo) or 0.8, openFrom, 1)
    local sweetSpot = (openFrom + openTo) / 2

    task.spawn(function()
        for i = 1, hitCount do
            if session.resolved then break end

            local roundStart = getServerTime()
            -- Mark 1 has an initial 0.40s lead-in delay in PixelQTE._thief & _timedMarks
            local initialLeadIn = (i == 1) and 0.40 or 0
            local markDelay = sweetSpot * targetSec
            -- Humanized micro-jitter: 5ms - 10ms (0.005s <= jitter <= 0.010s)
            local jitter = 0.005 + (math.random() * 0.005)
            -- 🎯 Clamp min wait to 0.26s so PixelQTE:_press passes the openedAt + 0.25 anti-spam window!
            local waitTime = math.clamp(initialLeadIn + markDelay + jitter, 0.26, 1.75)
            task.wait(waitTime)

            local pressTime = getServerTime()

            -- 1. Stream real-time SkillCheckPress packet to Server (prevents anti-macro MISS penalty)
            if not session.sentPresses[i] then
                session.sentPresses[i] = true
                sendSkillCheckPress(battleId, token, i, roundStart, pressTime)
            end

            -- 2. Native In-Memory Driver: Trigger PixelQTE visual feedback & animations
            local activeQte = session.qteSelf or (LivePBState and LivePBState.pixelQTE)
            if activeQte and activeQte.token == token then
                triggerPrecisionPress(activeQte, token)
            end

            -- Inter-mark transition delay in PixelQTE._thief & _timedMarks is exactly 0.34s
            if i < hitCount then
                task.wait(0.34 + (math.random() * 0.02))
            end
        end

        -- Completion Dispatch: Wait 0.15s after final mark, then fire ThiefSlashResult
        task.wait(0.15)
        if not session.resolved and RPGCommand and token ~= "" then
            session.resolved = true
            pcall(function()
                RPGCommand:FireServer("ThiefSlashResult", {
                    battleId = tostring(battleId or ""),
                    token = token,
                    hits = hitCount -- 🎯 CRITICAL FIX: INTEGER NUMBER, NEVER A TABLE!
                })
            end)
        end

        task.delay(1.5, function()
            ActiveQTESessions[token] = nil
        end)
    end)
end

local function solveMageQTE(qteSelf, data)
    if not CombatConfig.AutoQTE_Attack or type(data) ~= "table" then return end
    local token = tostring(data.token or "")
    if token == "" then return end

    local session = ActiveQTESessions[token]
    if session then
        if qteSelf then session.qteSelf = qteSelf end
        return
    end

    session = {
        token = token,
        qteSelf = qteSelf,
        resolved = false,
        sentPresses = {},
        startedAt = os.clock(),
    }
    ActiveQTESessions[token] = session

    local battleId = data.battleId
    local circles = type(data.circles) == "table" and data.circles or {}
    local sigilCount = math.min(4, math.max(1, #circles))
    local circleSec = math.clamp(tonumber(data.circleSeconds) or 0.95, 0.15, 1.5)
    local openWindow = math.clamp(tonumber(data.openWindow) or 0.72, 0.5, 0.95)
    -- Target safely inside the hit window (openWindow + 0.05) to avoid boundary "TOO EARLY" evaluations
    local targetProgress = math.min(0.92, openWindow + 0.05)

    task.spawn(function()
        for i = 1, sigilCount do
            if session.resolved then break end

            local roundStart = getServerTime()
            local hitDelay = targetProgress * circleSec
            -- Humanized micro-jitter: 5ms - 10ms (0.005s <= jitter <= 0.010s)
            local jitter = 0.005 + (math.random() * 0.005)
            -- 🎯 Clamp min wait to 0.26s so PixelQTE:_press passes the openedAt + 0.25 anti-spam window!
            local waitTime = math.clamp(hitDelay + jitter, 0.26, 1.45)
            task.wait(waitTime)

            local pressTime = getServerTime()

            -- 1. Stream real-time SkillCheckPress packet to Server (prevents anti-macro MISS penalty)
            if not session.sentPresses[i] then
                session.sentPresses[i] = true
                sendSkillCheckPress(battleId, token, i, roundStart, pressTime)
            end

            -- 2. Native In-Memory Driver: Trigger PixelQTE visual feedback & animations
            local activeQte = session.qteSelf or (LivePBState and LivePBState.pixelQTE)
            if activeQte and activeQte.token == token then
                local ok = triggerPrecisionPress(activeQte, token)
                if not ok and activeQte.currentCircle then
                    pcall(function()
                        local btn = activeQte.currentCircle
                        if firesignal then
                            firesignal(btn.Activated)
                        end
                    end)
                end
            end

            -- Transition interval between sigils in PixelQTE is 0.25s (wait 0.27s for clean next rune spawn)
            if i < sigilCount then
                task.wait(0.27 + (math.random() * 0.02))
            end
        end

        -- Completion Dispatch: Wait 0.15s after final circle, then fire MageRhythmResult
        task.wait(0.15)
        if not session.resolved and RPGCommand and token ~= "" then
            session.resolved = true
            pcall(function()
                RPGCommand:FireServer("MageRhythmResult", {
                    battleId = tostring(battleId or ""),
                    token = token,
                    hits = sigilCount -- 🎯 CRITICAL FIX: INTEGER NUMBER, NEVER A TABLE!
                })
            end)
        end

        task.delay(1.5, function()
            ActiveQTESessions[token] = nil
        end)
    end)
end

local function setupQTE()
    -- 1. Pre-cache LivePBState from RPGClient upvalues
    getLivePBState()

    local pbClient = getPBClient(false)
    if not pbClient then return false end

    -- 2. Hook PixelQTE (if 2D pixel mode triggers)
    local qteModule = pbClient:FindFirstChild("PixelQTE")
    if qteModule then
        local ok, PixelQTE = pcall(require, qteModule)
        if ok and type(PixelQTE) == "table" and PixelQTE.Handle and not PixelQTE.__bhHooked then
            PixelQTE.__bhHooked = true
            local oldHandle = PixelQTE.Handle
            PixelQTE.Handle = function(self, signal, payload)
                local res = oldHandle(self, signal, payload)
                if signal == "DefenseTimingStarted" then
                    solveDefenseQTE(self, payload)
                elseif signal == "WarriorBladeTimingStarted" then
                    solveWarriorQTE(self, payload)
                elseif signal == "ThiefSlashStarted" then
                    solveThiefQTE(self, payload)
                elseif signal == "MageRhythmStarted" then
                    solveMageQTE(self, payload)
                end
                return res
            end

            -- Intercept _send so Layer 2 knows native PixelQTE already resolved the token
            if type(PixelQTE._send) == "function" then
                local oldSend = PixelQTE._send
                PixelQTE._send = function(self, remoteName, payload)
                    if type(payload) == "table" and payload.token then
                        local session = ActiveQTESessions[tostring(payload.token)]
                        if session then
                            session.resolved = true
                        end
                    end
                    return oldSend(self, remoteName, payload)
                end
            end
        end
    end

    -- 3. Standalone DefenseTimingClient Hook
    local defModule = pbClient:FindFirstChild("DefenseTimingClient")
    if defModule then
        local defOk, DefenseTimingClient = pcall(require, defModule)
        if defOk and type(DefenseTimingClient) == "table" and DefenseTimingClient.Start and not DefenseTimingClient.__bhHooked then
            DefenseTimingClient.__bhHooked = true
            local oldStart = DefenseTimingClient.Start
            DefenseTimingClient.Start = function(self, payload)
                local res = oldStart(self, payload)
                if CombatConfig.AutoQTE_Defense then
                    solveDefenseQTE(self, payload)
                end
                return res
            end
        end
    end

    -- 4. Standalone WarriorBladeTimingClient Hook
    local warriorModule = pbClient:FindFirstChild("WarriorBladeTimingClient")
    if warriorModule then
        local wOk, WarriorBladeTimingClient = pcall(require, warriorModule)
        if wOk and type(WarriorBladeTimingClient) == "table" and WarriorBladeTimingClient.Start and not WarriorBladeTimingClient.__bhHooked then
            WarriorBladeTimingClient.__bhHooked = true
            local oldWarriorStart = WarriorBladeTimingClient.Start
            WarriorBladeTimingClient.Start = function(self, payload)
                local res = oldWarriorStart(self, payload)
                if CombatConfig.AutoQTE_Attack then
                    solveWarriorQTE(self, payload)
                end
                return res
            end
        end
    end

    -- 5. Standalone ThiefSlashClient Hook
    local thiefModule = pbClient:FindFirstChild("ThiefSlashClient")
    if thiefModule then
        local tOk, ThiefSlashClient = pcall(require, thiefModule)
        if tOk and type(ThiefSlashClient) == "table" and ThiefSlashClient.Start and not ThiefSlashClient.__bhHooked then
            ThiefSlashClient.__bhHooked = true
            local oldThiefStart = ThiefSlashClient.Start
            ThiefSlashClient.Start = function(self, payload)
                local res = oldThiefStart(self, payload)
                if CombatConfig.AutoQTE_Attack then
                    solveThiefQTE(self, payload)
                end
                return res
            end
        end
    end

    -- 6. Standalone MageRhythmClient Hook
    local mageModule = pbClient:FindFirstChild("MageRhythmClient")
    if mageModule then
        local mOk, MageRhythmClient = pcall(require, mageModule)
        if mOk and type(MageRhythmClient) == "table" and not MageRhythmClient.__bhHooked then
            local oldPlayCircle = MageRhythmClient._playCircle
            if oldPlayCircle then
                MageRhythmClient.__bhHooked = true
                MageRhythmClient._playCircle = function(self, circleData, circleSeconds, token, streak)
                    task.spawn(function()
                        if CombatConfig.AutoQTE_Attack then
                            local winStart = (circleData and tonumber(circleData.windowStart)) or 0.62
                            local dur = tonumber(circleSeconds) or 0.95
                            local jitter = 0.005 + (math.random() * 0.005)
                            local hitDelay = math.clamp(winStart * dur + jitter, 0.15, 1.2)
                            task.wait(hitDelay)
                            if self.active and self.token == token and self.currentCircle then
                                local btn = self.currentCircle
                                if firesignal then
                                    firesignal(btn.Activated)
                                elseif getconnections then
                                    for _, c in ipairs(getconnections(btn.Activated)) do
                                        if c and c.Fire then c:Fire() end
                                    end
                                end
                            end
                        end
                    end)
                    return oldPlayCircle(self, circleData, circleSeconds, token, streak)
                end
            end
        end
    end

    return true
end
