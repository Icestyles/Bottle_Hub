local function formatEggDisplayName(itemId)
    local s = tostring(itemId or "")
    if string.sub(s, 1, 3) == "Egg" then
        s = string.sub(s, 4)
    end
    local rarityFound = ""
    for _, r in ipairs({ "Legendary", "Common", "Uncommon", "Rare", "Epic", "Mythic" }) do
        if string.sub(s, -#r) == r then
            rarityFound = r
            s = string.sub(s, 1, -#r - 1)
            break
        end
    end
    local family = string.gsub(s, "(%l)(%u)", "%1 %2")
    if rarityFound ~= "" then
        return string.format("%s Egg (%s)", family, rarityFound)
    else
        return string.format("%s Egg", family)
    end
end

local function getAllEggsInInventory()
    local eggs = { "All Eggs" }
    local seen = { ["All Eggs"] = true }

    local inv = getProfileInventory()
    if inv and type(inv) == "table" then
        for key, item in pairs(inv) do
            local itemId = ""
            local count = 0

            if type(item) == "number" then
                itemId = tostring(key)
                count = item
            elseif type(item) == "table" then
                itemId = tostring(item.itemId or item.id or item.name or key or "")
                count = tonumber(item.count or item.amount or item.quantity or 1) or 1
            elseif type(item) == "string" then
                itemId = item
                count = 1
            end

            local lowId = string.lower(itemId)
            if string.find(lowId, "egg", 1, true) ~= nil and count > 0 then
                local disp = formatEggDisplayName(itemId)
                if not seen[disp] then
                    seen[disp] = true
                    table.insert(eggs, disp)
                end
            end
        end
    end

    if PetConfigMod and type(PetConfigMod.FamilyById) == "table" then
        for family, _ in pairs(PetConfigMod.FamilyById) do
            local name = family .. " Egg"
            if not seen[name] then
                seen[name] = true
                table.insert(eggs, name)
            end
        end
    else
        local knownEggs = { "Canine Egg", "Automaton Egg", "Spooky Egg", "Woodland Egg", "Haunted Egg" }
        for _, eggName in ipairs(knownEggs) do
            if not seen[eggName] then
                seen[eggName] = true
                table.insert(eggs, eggName)
            end
        end
    end

    return eggs
end

local function findEggToHatch()
    local chosenType = EggConfig.EggType
    local lowChosen = string.lower(tostring(chosenType or "All Eggs"))
    local cleanChosen = string.gsub(lowChosen, "%s*%[.*%]", "")
    cleanChosen = string.gsub(cleanChosen, "%s*egg", "")
    cleanChosen = string.gsub(cleanChosen, "%s*%(.*%)", "")
    cleanChosen = string.match(cleanChosen, "^%s*(.-)%s*$") or ""

    local inv = getProfileInventory()
    if inv and type(inv) == "table" then
        for key, item in pairs(inv) do
            local itemId = ""
            local count = 0

            if type(item) == "number" then
                itemId = tostring(key)
                count = item
            elseif type(item) == "table" then
                itemId = tostring(item.itemId or item.id or item.name or key or "")
                count = tonumber(item.count or item.amount or item.quantity or 1) or 1
            elseif type(item) == "string" then
                itemId = item
                count = 1
            end

            local lowId = string.lower(itemId)
            if string.find(lowId, "egg", 1, true) ~= nil and count > 0 then
                if lowChosen == "all eggs" or lowChosen == "" or lowChosen == "all" then
                    return itemId
                end

                local disp = formatEggDisplayName(itemId)
                local lowDisp = string.lower(disp)

                if string.find(lowDisp, lowChosen, 1, true)
                    or string.find(lowId, lowChosen, 1, true)
                    or (cleanChosen ~= "" and string.find(lowId, cleanChosen, 1, true)) then
                    return itemId
                end
            end
        end
    end

    -- Fallback: Scan PlayerGui inventory / ranch slots
    local pg = getPlayerGui(false)
    if pg then
        local pbUI = pg:FindFirstChild("PlatformBattlesUI") or pg:FindFirstChild("Inventory") or pg:FindFirstChild("Village") or pg:FindFirstChild("Ranch")
        if pbUI then
            for _, desc in ipairs(pbUI:GetDescendants()) do
                if desc:IsA("GuiButton") or desc:IsA("Frame") then
                    local text = ""
                    local tLabel = desc:FindFirstChildOfClass("TextLabel")
                    if tLabel then text = tLabel.Text end
                    local n = desc.Name
                    if string.find(string.lower(text), "egg", 1, true) or string.find(string.lower(n), "egg", 1, true) then
                        local matches = (lowChosen == "all eggs" or lowChosen == "")
                        if not matches then
                            matches = string.find(string.lower(text .. n), lowChosen, 1, true) ~= nil
                                or (cleanChosen ~= "" and string.find(string.lower(text .. n), cleanChosen, 1, true) ~= nil)
                        end
                        if matches then
                            local itemId = desc:GetAttribute("ItemId") or desc:GetAttribute("itemId") or desc:GetAttribute("Id") or desc.Name
                            return itemId
                        end
                    end
                end
            end
        end
    end
    return nil
end

