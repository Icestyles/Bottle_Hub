-- Hook RunMapView directly in memory for seamless native integration
local function hookRunMapView()
    local pbClient = getPBClient(false)
    local runMapModule = pbClient and pbClient:FindFirstChild("RunMapView")
    if not runMapModule then return false end

    local ok, RunMapView = pcall(require, runMapModule)
    if not ok or type(RunMapView) ~= "table" or not RunMapView.SetState then return false end

    if RunMapView.__bhHooked then return true end
    RunMapView.__bhHooked = true

    local oldSetState = RunMapView.SetState
    RunMapView.SetState = function(self, newState)
        local res = oldSetState(self, newState)

        task.defer(function()
            pcall(function()
                if type(newState) == "table" then
                    LatestRunState = newState
                    local actNum = tonumber(newState.startAct or newState.act)
                    if actNum and actNum > 0 then
                        LastPlayedAct = actNum
                    end
                    updateStageDisplay(newState)

                    if newState.phase == "event" or newState.phase == "victory" or newState.phase == "completed" then
                        autoClaimDungeonChests()
                    end
                end

                -- Normal Mode Single-Act Synchronization: Block advancing into next Act!
                if isNormalActFinished(newState) then
                    performSafeReturnHome(newState)
                    return
                end

                if DungeonConfig.AutoChooseNode and type(newState) == "table" then
                    local phase = newState.phase or ""
                    local runId = newState.id
                    local round = newState.round or 1
                    local phaseKey = string.format("%s:%s:%s", tostring(runId), tostring(round), tostring(phase))

                    -- Shared phase lock so RPGState.OnClientEvent won't fire a duplicate action
                    if lastHandledMapPhase == phaseKey then
                        return
                    end
                    lastHandledMapPhase = phaseKey

                    -- 1. Auto-Vote Best Route Node
                    if phase == "choose" and newState.choices and #newState.choices > 0 then
                        local bestIdx = selectBestNodeChoice(newState.choices)
                        task.delay(0.35, function()
                            if self.state and self.state.phase == "choose" then
                                if isNormalActFinished(self.state) then
                                    performSafeReturnHome(self.state)
                                    return
                                end
                                pcall(function()
                                    self:_send({
                                        action = "vote",
                                        choice = bestIdx
                                    }, self.state)
                                    if self.votes and self.player then
                                        self.votes[self.player.UserId] = bestIdx
                                        if self._refreshVotes then
                                            self:_refreshVotes()
                                        end
                                    end
                                end)
                            end
                        end)

                    -- 2. Auto-Confirm Event / Shop
                    elseif phase == "event" or phase == "mystery" then
                        autoClaimDungeonChests()
                        task.delay(0.6, function()
                            if self.state and (self.state.phase == "event" or self.state.phase == "mystery") then
                                if isNormalActFinished(self.state) then
                                    performSafeReturnHome(self.state)
                                    return
                                end
                                pcall(function()
                                    self:_send({ action = "eventReady" }, self.state)
                                end)
                            end
                        end)

                    -- 3. Auto-Progress Story Dialogues
                    elseif phase == "story" then
                        task.delay(0.4, function()
                            if self.state and self.state.phase == "story" then
                                if isNormalActFinished(self.state) then
                                    performSafeReturnHome(self.state)
                                    return
                                end
                                pcall(function()
                                    self:_send({ action = "storyChoice", choice = "continue" }, self.state)
                                end)
                            end
                        end)

                    -- 4. Auto-Replay or Return Lobby Upon Floor Completion
                    elseif phase == "completed" or phase == "victory" or phase == "ended" or newState.active == false then
                        if DungeonConfig.AutoReplay then
                            triggerAutoReplay(newState)
                        else
                            performSafeReturnHome(newState)
                        end
                    end
                end
            end)
        end)

        return res
    end

    return true
end

