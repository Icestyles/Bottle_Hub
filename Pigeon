                        local chosenType = string.lower(EggConfig.EggType)
                        for _, desc in ipairs(ranchGui:GetDescendants()) do
                            if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                                local bText = string.lower(tostring(desc.Name .. " " .. (desc:IsA("TextButton") and desc.Text or "")))
                                local parentName = desc.Parent and string.lower(desc.Parent.Name) or ""
