                                local text = string.lower(tostring(desc.Name .. " " .. (desc:IsA("TextButton") and desc.Text or "")))
                                if string.find(text, "egg", 1, true) and not string.find(text, "hatch", 1, true) and not string.find(text, "card", 1, true) then
                                    if firesignal then
                                        firesignal(desc.MouseButton1Click)
