-- Helper: Single-Select Embedded "Title : Value" Dropdown
local function createSelect(tab, title, optionsList, defaultVal, callback)
    if type(tab.CreateSelect) == "function" then
        return tab:CreateSelect(title, optionsList, defaultVal, callback)
    end

    local formattedOptions = {}
    local prefix = title .. " : "
    for _, opt in ipairs(optionsList) do
        table.insert(formattedOptions, prefix .. tostring(opt))
    end

    local initial = defaultVal or "None"
    local initialDisplay = prefix .. tostring(initial)

    local drop
    drop = tab:CreateDropdown(title, formattedOptions, false, function(selected)
        local raw = (type(selected) == "table" and selected[1]) or tostring(selected or "")
        local clean = string.gsub(raw, "^" .. title .. "%s*:%s*", "")
        if clean == "" then clean = "None" end
        if callback then
            callback(clean)
        end
    end)

    if drop and drop.Set then
        pcall(function()
            drop:Set(initialDisplay, true)
        end)
    end

    return drop
end

