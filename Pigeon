local NativeMenuHooked = false

-- Unified Combat State & Turn Lock
local CombatState = {
    CurrentBattle = nil,
    DispatchedTurnKey = "",
    PendingDispatchThread = nil,
    ActiveMenu = nil,
}

local function getTurnKey(snapshot)
    if type(snapshot) ~= "table" or not snapshot.id then return "" end
    -- Strictly use battleId and turnNumber. Never use revision to prevent repeat dispatches!
    return string.format("%s:%s", tostring(snapshot.id), tostring(snapshot.turnNumber or 1))
end

local function selectTargetEnemy(enemies, strategy)
    local aliveFoes = {}
    for idx, foe in ipairs(enemies or {}) do
        local actor = (type(foe) == "table" and foe.actor) or foe
        local hp = tonumber(foe.hp) or (actor and tonumber(actor.hp)) or 100
        local isDefeated = foe.defeated == true or (actor and actor.defeated == true) or hp <= 0
        if not isDefeated and hp > 0 then
            table.insert(aliveFoes, {
                index = tonumber(foe.index) or idx,
                hp = hp,
                isBoss = foe.boss == true or foe.isBoss == true or (actor and (actor.boss == true or actor.isBoss == true or actor.category == "boss" or actor.kind == "boss"))
            })
        end
    end

    if #aliveFoes == 0 then return 1 end

    local strat = (type(strategy) == "table" and strategy[1]) or tostring(strategy or "LowestHP")
    if strat == "LowestHP" or strat == "None" or strat == "" then
        table.sort(aliveFoes, function(a, b) return a.hp < b.hp end)
        return aliveFoes[1].index
    elseif strat == "Boss" then
        for _, f in ipairs(aliveFoes) do
            if f.isBoss then return f.index end
        end
        return aliveFoes[1].index
    else
        return aliveFoes[1].index
    end
end

local function isScrollAction(act)
    if type(act) ~= "table" then return false end
    local id = string.lower(tostring(act.id or ""))
    local cat = string.lower(tostring(act.category or act.kind or ""))
    return act.scrollId ~= nil or string.find(id, "scroll_", 1, true) ~= nil or cat == "gearscroll" or string.find(cat, "scroll", 1, true) ~= nil
end

local function getSkillCost(skill): number
    if type(skill) ~= "table" then return 0 end
    -- 📜 Scrolls do NOT consume any Energy (0 MP / 0 Cost)
    if isScrollAction(skill) then return 0 end
    local c = tonumber(skill.cost)
    if c then return c end
    local ec = tonumber(skill.energyCost)
    if ec then return ec end
    local mp = tonumber(skill.mpCost)
    if mp then return math.ceil(mp / 10) end
    return 0
end

local function getMyEnergy(menu, snapshot)
    if menu and menu._myEnergy then
        local ok, curMp = pcall(function() return menu:_myEnergy() end)
        if ok and curMp ~= nil then return curMp end
    end
    if snapshot and type(snapshot.party) == "table" then
        local myId = tonumber(LocalPlayer.UserId)
        for _, member in ipairs(snapshot.party) do
            if tonumber(member.userId) == myId then
                return tonumber(member.mp) or 0
            end
        end
    end
    return 0
end

local function getLocalMemberHP(snapshot)
    if not snapshot then return 100, 100, 1 end

    -- 1. Match by local player's UserId in party if party exists
    local myId = tonumber(LocalPlayer.UserId)
    if type(snapshot.party) == "table" then
        for _, member in ipairs(snapshot.party) do
            local memId = tonumber(member.userId or member.id)
            if memId and memId == myId and member.hp ~= nil then
                local hp = tonumber(member.hp) or 0
                local maxHp = math.max(1, tonumber(member.maxHp) or 1)
                return hp, maxHp, math.clamp(hp / maxHp, 0, 1)
            end
        end
    end

    -- 2. Direct snapshot.player (standard in combat snapshot for local actor)
    if type(snapshot.player) == "table" and snapshot.player.hp ~= nil then
        local hp = tonumber(snapshot.player.hp) or 0
        local maxHp = math.max(1, tonumber(snapshot.player.maxHp) or 1)
        return hp, maxHp, math.clamp(hp / maxHp, 0, 1)
    end

    -- 3. Party first member fallback
    if type(snapshot.party) == "table" and #snapshot.party > 0 then
        local member = snapshot.party[1]
        local hp = tonumber(member.hp) or 0
        local maxHp = math.max(1, tonumber(member.maxHp) or 1)
        return hp, maxHp, math.clamp(hp / maxHp, 0, 1)
    end

    -- 4. Humanoid fallback
    local char = LocalPlayer and LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        return hum.Health, hum.MaxHealth, math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
    end
    return 100, 100, 1
end

local function findHealingAction(Groups, allActions, snapshot)
    if snapshot and type(snapshot.satchel) == "table" and tonumber(snapshot.satchel.hp) and tonumber(snapshot.satchel.hp) >= 3 then
        return nil
    end

    for _, act in ipairs((Groups and Groups.Item) or {}) do
        if act.enabled ~= false and (act.count == nil or (tonumber(act.count) or 0) > 0) then
            local text = string.lower(tostring(act.name or act.id or act.text or ""))
            if string.find(text, "heal", 1, true) or string.find(text, "potion", 1, true)
                or string.find(text, "tonic", 1, true) or string.find(text, "satchel", 1, true)
                or string.find(text, "draught", 1, true) or string.find(text, "nectar", 1, true)
                or string.find(text, "salve", 1, true) or act.heal ~= nil then
                return act
            end
        end
    end

    for _, act in ipairs(allActions or {}) do
        if act.enabled ~= false and (act.count == nil or (tonumber(act.count) or 0) > 0) then
            local id = tostring(act.id or "")
            local cat = tostring(act.category or "")
            local name = string.lower(tostring(act.name or ""))
            if id == "Potion" or cat == "Item" or string.find(name, "potion", 1, true) or string.find(name, "heal", 1, true) then
                return act
            end
        end
    end

    -- First available item action
    for _, act in ipairs((Groups and Groups.Item) or {}) do
        if act.enabled ~= false and (act.count == nil or (tonumber(act.count) or 0) > 0) then
            return act
        end
    end

    -- Synthetic fallback for Satchel Potion (standard actionId "Potion" in Pixel Lineage)
    return {
        id = "Potion",
        category = "Item",
        name = "Potion",
        targetType = "Self",
        enabled = true
    }
end

