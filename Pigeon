local SkillScalingModule = nil
pcall(function()
    local pb = ReplicatedStorage:FindFirstChild("PlatformBattles")
    local shared = pb and pb:FindFirstChild("Shared")
    local mod = shared and shared:FindFirstChild("SkillScaling")
    if mod then
        SkillScalingModule = require(mod)
    end
end)

local function getTargetEnemyData(enemies, targetIdx)
    for idx, foe in ipairs(enemies or {}) do
        local foeIdx = tonumber(foe.index) or idx
        if foeIdx == targetIdx then
            local actor = (type(foe) == "table" and foe.actor) or foe
            local hp = tonumber(foe.hp) or (actor and tonumber(actor.hp)) or 100
            local maxHp = math.max(1, tonumber(foe.maxHp) or (actor and tonumber(actor.maxHp)) or 100)
            local isBoss = foe.boss == true or foe.isBoss == true or (actor and (actor.boss == true or actor.isBoss == true or actor.category == "boss" or actor.kind == "boss"))
            return {
                data = foe,
                index = foeIdx,
                hp = hp,
                maxHp = maxHp,
                isBoss = isBoss,
                statuses = foe.statuses or (actor and actor.statuses) or {}
            }
        end
    end
    return {
        data = nil,
        index = targetIdx or 1,
        hp = 100,
        maxHp = 100,
        isBoss = false,
        statuses = {}
    }
end

local function calculateExpectedDamage(action, targetFoe, snapshot)
    if type(action) ~= "table" then return 1 end

    -- Extract local player member data from party
    local myMember = nil
    if snapshot and type(snapshot.party) == "table" then
        local myId = tonumber(LocalPlayer.UserId)
        for _, member in ipairs(snapshot.party) do
            if tonumber(member.userId) == myId then
                myMember = member
                break
            end
        end
        if not myMember and #snapshot.party > 0 then
            myMember = snapshot.party[1]
        end
    end

    local scaling = tostring(action.scaling or "")
    if scaling == "" or scaling == "nil" then
        if isScrollAction(action) or string.find(string.lower(tostring(action.category or "")), "scroll", 1, true) then
            scaling = "magic"
        else
            scaling = "attack"
        end
    end

    -- Base Stat Power via SkillScaling module if available
    local baseStat = 0
    if SkillScalingModule and type(SkillScalingModule.Value) == "function" and myMember then
        local ok, val = pcall(SkillScalingModule.Value, myMember, action)
        if ok and tonumber(val) and val > 0 then
            baseStat = tonumber(val)
        end
    end

    -- Fallback base stat
    if baseStat <= 0 then
        local level = tonumber(myMember and myMember.level) or 1
        if scaling == "magic" then
            baseStat = tonumber(myMember and myMember.magic) or (20 + level * 3.5)
        elseif scaling == "defense" then
            baseStat = tonumber(myMember and myMember.defense) or (15 + level * 2.5)
        elseif scaling == "best" then
            local atk = tonumber(myMember and myMember.attack) or (25 + level * 3.5)
            local mag = tonumber(myMember and myMember.magic) or (20 + level * 3.5)
            baseStat = math.max(atk, mag)
        else
            baseStat = tonumber(myMember and myMember.attack) or (25 + level * 3.5)
        end
    end

    local power = tonumber(action.power) or 1.0
    local hits = tonumber(action.hits) or 1
    local buffMult = 1.0

    if myMember and type(myMember.statuses) == "table" then
        if myMember.statuses.Inspired then buffMult = buffMult + 0.35 end
        if myMember.statuses.BattleFury then buffMult = buffMult + 0.25 end
        if myMember.statuses.Weakened then buffMult = buffMult - 0.15 end
    end

    local rawDamage = baseStat * power * hits * math.max(0.2, buffMult)

    -- Effective Defense reduction (~15% base, reduced by armorPierce)
    local armorPierce = tonumber(action.armorPierce) or 0
    local baseDef = 0.15
    local effectiveDef = math.clamp(baseDef * (1 - armorPierce), 0, 0.8)

    local netDamage = math.max(1, math.floor(rawDamage * (1 - effectiveDef) + 0.5))
    return netDamage
end

local function isSummonAction(act)
    if type(act) ~= "table" then return false, nil end
    if act.summon and type(act.summon) == "table" then
        return true, tostring(act.summon.kind or act.summon.label or "Summon")
    end
    local kind = tostring(act.kind or "")
    if kind == "SummonUndead" then return true, "Undead" end
    if kind == "SummonSylph" then return true, "Sylph" end
    local id = string.lower(tostring(act.id or ""))
    if string.find(id, "summon", 1, true) or string.find(id, "beast_wolves", 1, true) or string.find(id, "beast_bear", 1, true) then
        return true, id
    end
    return false, nil
end

local function hasActiveSummon(snapshot, summonKind)
    if not snapshot then return false end
    if type(snapshot.party) == "table" then
        local myId = tonumber(LocalPlayer.UserId)
        for _, member in ipairs(snapshot.party) do
            if member.kind == "Companion" or member.isSummon == true or (member.ownerUserId and tonumber(member.ownerUserId) == myId) then
                if not summonKind then
                    return true
                end
                local mName = string.lower(tostring(member.name or member.id or ""))
                if string.find(mName, string.lower(tostring(summonKind)), 1, true) then
                    return true
                end
            end
        end
    end
    if type(snapshot.companions) == "table" and #snapshot.companions > 0 then
        return true
    end
    return false
end

local function dispatchNativeAction(menu, snapshot, action, targetIdx)
    if not action or not action.id then return false end
    local targetType = tostring(action.targetType or "")
    local payload = nil
    if targetType == "Enemy" then
        payload = { targetEnemyIndex = targetIdx or 1 }
    elseif targetType == "Ally" then
        payload = { targetUserId = LocalPlayer.UserId }
    elseif targetType ~= "AllEnemies" and targetType ~= "Self" and targetType ~= "SelfOnly" and action.category ~= "Meditate" and action.category ~= "Guard" and action.category ~= "Item" then
        -- Default single enemy target fallback if targetType is unspecified
        payload = { targetEnemyIndex = targetIdx or 1 }
    end
    -- NOTE: For "AllEnemies", "Self", "SelfOnly", or category == "Item", payload MUST remain nil per native PixelCommandMenu rules!

    if menu and menu._send then
        local ok = pcall(function()
            if payload then
                menu:_send(action, payload)
            else
                menu:_send(action)
            end
        end)
        if ok then return true end
    end

    -- Direct remote fallback if menu:_send failed or menu not available
    if RPGCommand and snapshot and snapshot.id then
        local p = { battleId = snapshot.id, actionId = action.id }
        if payload then
            for k, v in pairs(payload) do p[k] = v end
        end
        RPGCommand:FireServer("CombatAction", p)
        return true
    end
    return false
end

local function executeNativeTurn(menu, snapshot)
    if not CombatConfig.AutoTurn or not snapshot or not snapshot.id or snapshot.canAct ~= true then
        return
    end

    if menu and menu._canAct and not menu:_canAct() then
        return
    end

    local battleId = snapshot.id
    local actions = snapshot.actions or {}
    local enemies = snapshot.enemies or {}

    -- Group actions using native menu.actions if available, else group manually
    local Groups = { Attack = {}, Skill = {}, Scroll = {}, Guard = {}, Meditate = {}, Item = {} }
    if menu and type(menu.actions) == "table" and menu.actions.Attack then
        for k, v in pairs(menu.actions) do
            if Groups[k] then
                Groups[k] = v
            end
        end
    else
        for _, act in ipairs(actions) do
            local cat = act.category or act.kind or act.id or ""
            local low = string.lower(tostring(cat))

            if isScrollAction(act) then
                table.insert(Groups.Scroll, act)
            elseif low == "meditate" then
                table.insert(Groups.Meditate, act)
            elseif string.find(low, "skill", 1, true) or string.find(low, "spell", 1, true) or string.find(low, "ability", 1, true) then
                table.insert(Groups.Skill, act)
            elseif string.find(low, "item", 1, true) or string.find(low, "potion", 1, true) or string.find(low, "satchel", 1, true) then
                table.insert(Groups.Item, act)
            elseif string.find(low, "guard", 1, true) or string.find(low, "defend", 1, true) then
                table.insert(Groups.Guard, act)
            else
                table.insert(Groups.Attack, act)
            end
        end
    end

    -- Ensure any scrolls categorized into Attack/Skill are also present in Groups.Scroll
    for _, act in ipairs(actions) do
        if isScrollAction(act) and not table.find(Groups.Scroll, act) then
            table.insert(Groups.Scroll, act)
        end
    end

    -- 1. Emergency Potion Heal (Satchel) - checks true combat HP from snapshot.party
    local curHp, maxHp, hpPct = getLocalMemberHP(snapshot)
    if CombatConfig.AutoHeal_Satchel and hpPct <= CombatConfig.AutoHeal_Threshold then
        local healAction = findHealingAction(Groups, actions, snapshot)
        if healAction then
            dispatchNativeAction(menu, snapshot, healAction)
            return
        end
    end

    -- 2. Boss Brace Warning Guard
    if CombatConfig.AutoGuard_Brace and #Groups.Guard > 0 then
        local bossTelegraph = false
        for _, foe in ipairs(enemies) do
            local tele = foe.actor and foe.actor.telegraph
            if tele and tonumber(tele.targetUserId) == tonumber(LocalPlayer.UserId) and not foe.defeated then
                bossTelegraph = true
                break
            end
        end
        if bossTelegraph then
            dispatchNativeAction(menu, snapshot, Groups.Guard[1])
            return
        end
    end

    -- Target selection
    local rawTarget = CombatConfig.TargetStrategy
    local targetStrategy = (type(rawTarget) == "table" and rawTarget[1]) or tostring(rawTarget or "LowestHP")
    local targetIdx = selectTargetEnemy(enemies, targetStrategy)

    local rawMode = CombatConfig.CombatMode
    local mode = (type(rawMode) == "table" and rawMode[1]) or tostring(rawMode or "None")

    -- Player Energy
    local myMp = getMyEnergy(menu, snapshot)

    if mode == "None" or mode == "" then
        return
    end

    -- Parse Skills & Energy Costs
    local parsedSkills = {}
    for _, skill in ipairs(Groups.Skill) do
        local rawCost = getSkillCost(skill)
        local cd = tonumber(skill.cooldown) or 0
        local isEnabled = (skill.enabled ~= false) and (cd <= 0)
        table.insert(parsedSkills, {
            data = skill,
            cost = rawCost,
            enabled = isEnabled,
            canAfford = isEnabled and (myMp >= rawCost)
        })
    end

    -- Parse Scrolls & Energy Costs
    local parsedScrolls = {}
    for _, scroll in ipairs(Groups.Scroll) do
        local rawCost = getSkillCost(scroll)
        local cd = tonumber(scroll.cooldown) or 0
        local isEnabled = (scroll.enabled ~= false) and (cd <= 0)
        table.insert(parsedScrolls, {
            data = scroll,
            cost = rawCost,
            enabled = isEnabled,
            canAfford = isEnabled and (myMp >= rawCost)
        })
    end

    -- ─────────────────────────────────────────────────────────────
    -- 🧠 MODE 1: SMART (Advance Damage AI + Anti-Overkill + Summon Optimization)
    -- ─────────────────────────────────────────────────────────────
    if mode == "Smart" then
        local targetFoe = getTargetEnemyData(enemies, targetIdx)
        local foeHp = targetFoe.hp
        local foeMaxHp = targetFoe.maxHp
        local isBoss = targetFoe.isBoss

        local basicAttack = Groups.Attack[1]
        local basicDamage = basicAttack and calculateExpectedDamage(basicAttack, targetFoe, snapshot) or 30

        -- 1. Anti-Overkill Rule 1: Basic Attack Finisher
        -- If enemy HP <= expected Basic Attack damage, kill it with 0 energy!
        if CombatConfig.AntiOverkill and basicAttack and basicAttack.enabled ~= false and foeHp <= basicDamage then
            dispatchNativeAction(menu, snapshot, basicAttack, targetIdx)
            return
        end

        -- 2. Smart Summon Optimization: Priority in turn 1-2 on high-HP enemy or boss
        if CombatConfig.SmartSummon then
            local isTargetWorthSummon = isBoss or foeHp >= (basicDamage * 2.5) or (foeHp / math.max(1, foeMaxHp) > 0.40)
            if isTargetWorthSummon then
                for _, s in ipairs(parsedSkills) do
                    if s.canAfford then
                        local isSummon, summonKind = isSummonAction(s.data)
                        if isSummon and not hasActiveSummon(snapshot, summonKind) then
                            dispatchNativeAction(menu, snapshot, s.data, targetIdx)
                            return
                        end
                    end
                end
            end
        end

        -- 3. Anti-Overkill Rule 2: Exact-Cost Skill / Scroll Finisher
        -- If an affordable skill or 0-energy scroll can kill the enemy in 1 hit, choose the one with the LOWEST Energy cost!
        if CombatConfig.AntiOverkill then
            local killSkills = {}
            for _, s in ipairs(parsedSkills) do
                if s.canAfford then
                    local expDmg = calculateExpectedDamage(s.data, targetFoe, snapshot)
                    if expDmg >= foeHp then
                        table.insert(killSkills, {
                            skill = s.data,
                            cost = s.cost,
                            dmg = expDmg
                        })
                    end
                end
            end
            -- Integrate Scrolls: 0 Energy cost finishers!
            for _, sc in ipairs(parsedScrolls) do
                if sc.canAfford then
                    local expDmg = calculateExpectedDamage(sc.data, targetFoe, snapshot)
                    if expDmg >= foeHp then
                        table.insert(killSkills, {
                            skill = sc.data,
                            cost = 0,
                            dmg = expDmg
                        })
                    end
                end
            end
            if #killSkills > 0 then
                table.sort(killSkills, function(a, b)
                    if a.cost ~= b.cost then
                        return a.cost < b.cost -- Lowest cost first! (0-energy scrolls win!)
                    end
                    return a.dmg < b.dmg -- Lowest overkill first!
                end)
                dispatchNativeAction(menu, snapshot, killSkills[1].skill, targetIdx)
                return
            end
        end

        -- 4. General Combat Scoring: Damage-per-Energy (DPE) & AoE / Status Utility + 0-Energy Scrolls
        local scoredSkills = {}
        local livingFoesCount = 0
        for _, f in ipairs(enemies) do
            local actor = (type(f) == "table" and f.actor) or f
            local fHp = tonumber(f.hp) or (actor and tonumber(actor.hp)) or 0
            if not f.defeated and fHp > 0 then
                livingFoesCount = livingFoesCount + 1
            end
        end

        for _, s in ipairs(parsedSkills) do
            if s.canAfford then
                local expDmg = calculateExpectedDamage(s.data, targetFoe, snapshot)
                local cost = math.max(1, s.cost)
                local dpe = expDmg / cost
                local score = (expDmg * 0.5) + (dpe * 10 * 0.5)

                -- AoE bonus if multiple foes alive
                if (s.data.allEnemies or s.data.aoe) and livingFoesCount > 1 then
                    score = score * (1.0 + (livingFoesCount * 0.35))
                end

                -- Utility/Debuff bonus
                if s.data.inflict then
                    score = score * 1.15
                end

                table.insert(scoredSkills, {
                    skill = s.data,
                    score = score
                })
            end
        end

        -- Evaluate ready Scrolls in Smart Combat (0 Energy Cost -> High Priority Damage Burst)
        for _, sc in ipairs(parsedScrolls) do
            if sc.canAfford then
                local expDmg = calculateExpectedDamage(sc.data, targetFoe, snapshot)
                -- 0-Energy Scroll Burst Score: base damage + bonus since it consumes 0 MP
                local score = (expDmg * 0.6) + 35

                -- AoE bonus if multiple foes alive (e.g. Meteor / Blizzard)
                if (sc.data.allEnemies or sc.data.aoe) and livingFoesCount > 1 then
                    score = score * (1.0 + (livingFoesCount * 0.4))
                end

                if sc.data.inflict then
                    score = score * 1.15
                end

                table.insert(scoredSkills, {
                    skill = sc.data,
                    score = score
                })
            end
        end

        if #scoredSkills > 0 then
            table.sort(scoredSkills, function(a, b)
                return a.score > b.score
            end)
            dispatchNativeAction(menu, snapshot, scoredSkills[1].skill, targetIdx)
            return
        end

        -- 5. Fallback: Meditate if no energy and out of skills, else Basic Attack
        if CombatConfig.AutoMeditate_NoEnergy and #Groups.Meditate > 0 and myMp <= 1 then
            dispatchNativeAction(menu, snapshot, Groups.Meditate[1])
            return
        elseif #Groups.Attack > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Attack[1], targetIdx)
            return
        elseif #Groups.Meditate > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Meditate[1])
            return
        end

    -- ─────────────────────────────────────────────────────────────
    -- 🥊 MODE 2: BASIC (Continuously Attack with basic attack)
    -- ─────────────────────────────────────────────────────────────
    elseif mode == "Basic" then
        if #Groups.Attack > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Attack[1], targetIdx)
            return
        elseif #Groups.Meditate > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Meditate[1])
            return
        end

    -- ─────────────────────────────────────────────────────────────
    -- ⚡ MODE 4: MAXIMUM (Focus on Skills! Meditate spam & always cast HIGHEST energy cost skill first)
    -- ─────────────────────────────────────────────────────────────
    elseif mode == "Maximum" then
        local targetFoe = getTargetEnemyData(enemies, targetIdx)
        local foeHp = targetFoe.hp
        local basicAttack = Groups.Attack[1]
        local basicDamage = basicAttack and calculateExpectedDamage(basicAttack, targetFoe, snapshot) or 30

        -- Anti-Overkill: Don't blow huge skills on 1-hit killable mobs even in Maximum mode
        if CombatConfig.AntiOverkill and basicAttack and basicAttack.enabled ~= false and foeHp <= basicDamage then
            dispatchNativeAction(menu, snapshot, basicAttack, targetIdx)
            return
        end

        table.sort(parsedSkills, function(a, b)
            return a.cost > b.cost
        end)

        local highestSkill = nil
        for _, s in ipairs(parsedSkills) do
            if s.enabled then
                highestSkill = s
                break
            end
        end

        if highestSkill and highestSkill.canAfford then
            dispatchNativeAction(menu, snapshot, highestSkill.data, targetIdx)
            return
        end

        if #Groups.Meditate > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Meditate[1])
            return
        elseif #Groups.Attack > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Attack[1], targetIdx)
            return
        end

    -- ─────────────────────────────────────────────────────────────
    -- 📜 MODE 5: SCROLL (Prioritize Scrolls, fallback to Skill then Attack)
    -- ─────────────────────────────────────────────────────────────
    elseif mode == "Scroll" then
        local affordableScroll = nil
        for _, s in ipairs(parsedScrolls) do
            if s.canAfford then
                affordableScroll = s.data
                break
            end
        end

        if affordableScroll then
            dispatchNativeAction(menu, snapshot, affordableScroll, targetIdx)
            return
        end

        local affordableSkill = nil
        for _, s in ipairs(parsedSkills) do
            if s.canAfford then
                affordableSkill = s.data
                break
            end
        end

        if affordableSkill then
            dispatchNativeAction(menu, snapshot, affordableSkill, targetIdx)
            return
        elseif #Groups.Attack > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Attack[1], targetIdx)
            return
        elseif #Groups.Meditate > 0 then
            dispatchNativeAction(menu, snapshot, Groups.Meditate[1])
            return
        end
    end

    -- Universal fallback
    if #actions > 0 then
        dispatchNativeAction(menu, snapshot, actions[1], targetIdx)
    end
end

local function safeExecuteNativeTurn(menu, snapshot)
    local ok, err = pcall(executeNativeTurn, menu, snapshot)
    if not ok then
        warn("[BottleHub] ⚠️ Error in executeNativeTurn:", err)
        if snapshot and snapshot.id and type(snapshot.actions) == "table" and #snapshot.actions > 0 then
            dispatchNativeAction(menu, snapshot, snapshot.actions[1], 1)
        end
    end
end

local function dispatchTurnAction(menu, snapshot, source)
    if not CombatConfig.AutoTurn then return end
    local rawMode = CombatConfig.CombatMode
    local mode = (type(rawMode) == "table" and rawMode[1]) or tostring(rawMode or "None")
    if mode == "None" or mode == "" then
        return
    end

    if not snapshot or snapshot.canAct ~= true then return end
    if menu and menu._canAct and not menu:_canAct() then
        return
    end

    local turnKey = getTurnKey(snapshot)
    if turnKey == "" or CombatState.DispatchedTurnKey == turnKey then
        -- Strict lock: Turn already dispatched! Never re-send.
        return
    end

    -- Cancel any previously scheduled pending dispatch
    if CombatState.PendingDispatchThread then
        pcall(task.cancel, CombatState.PendingDispatchThread)
        CombatState.PendingDispatchThread = nil
    end

    -- Mark turn as dispatched immediately to prevent any concurrent race condition
    CombatState.DispatchedTurnKey = turnKey

    local delayTime = (source == "ToggleEnabled" or source == "ModeSelected") and 0.05 or (CombatConfig.DispatchDelayMin + math.random() * (CombatConfig.DispatchDelayMax - CombatConfig.DispatchDelayMin))

    CombatState.PendingDispatchThread = task.delay(delayTime, function()
        CombatState.PendingDispatchThread = nil
        if snapshot and snapshot.id and (menu == nil or menu._canAct == nil or menu:_canAct()) then
            safeExecuteNativeTurn(menu, snapshot)
        end
    end)
end

local function hookPixelCommandMenu()
    local pbClient = getPBClient(false)
    local mod = pbClient and pbClient:FindFirstChild("PixelCommandMenu")
    if not mod then
