-- ⚡ VALOR AUTO-UPGRADE SYSTEM (Post-Torment Ranks)
-- ═══════════════════════════════════════════════════════════════════

upgradeValorAll = function()
    if not DungeonConfig.AutoUpgradeValor then return end
    local prof = extractProfileFromMemory()
    if not prof then return end

    local curRank = tonumber(prof.lineage or prof.lineageRank or prof.tormentRank) or 0
    local valor = tonumber(prof.valor) or 0
    local gold = tonumber(prof.gold) or 0

    local TormentConfigMod = nil
    pcall(function()
        local pbShared = ReplicatedStorage:FindFirstChild("PlatformBattles") and ReplicatedStorage.PlatformBattles:FindFirstChild("Shared")
        if pbShared and pbShared:FindFirstChild("TormentConfig") then
            TormentConfigMod = require(pbShared.TormentConfig)
        end
    end)

    local function getRankCost(r)
        if TormentConfigMod and type(TormentConfigMod.RankCost) == "function" then
            local ok, vC, gC = pcall(TormentConfigMod.RankCost, r)
            if ok and vC and gC then return vC, gC end
        end
        local mult = 1.044 ^ math.max(0, math.floor(r))
        local vC = math.max(1, math.floor(8 * mult + 0.5))
        local gC = math.max(1, math.floor(20000 * mult + 0.5))
        return vC, gC
    end

    local pReq = Remotes and Remotes:FindFirstChild("ProfileRequest")
    local upgradesDone = 0

    while true do
        local needValor, needGold = getRankCost(curRank)
        if valor < needValor or gold < needGold then
            break
        end

        local success = false
        if pReq then
            pcall(function()
                local res = pReq:InvokeServer("Village", { action = "upgradeLineage" })
                if res and res.ok ~= false and res.success ~= false then success = true end
            end)
            if not success then
                pcall(function()
                    pReq:InvokeServer("Village", { action = "lineageRank" })
                    success = true
                end)
            end
        end

        if not success and RPGCommand then
            pcall(function()
                RPGCommand:FireServer("UpgradeLineage", {})
                RPGCommand:FireServer("LineageRank", {})
                success = true
            end)
        end

        valor = valor - needValor
        gold = gold - needGold
        curRank = curRank + 1
        upgradesDone = upgradesDone + 1

        task.wait(0.2)
        if upgradesDone >= 50 then break end
    end

    if upgradesDone > 0 and TormentTrackerLabel then
        local best = prof.tormentBest or 1
        TormentTrackerLabel:SetText(string.format("Torment Best: Tier %d | Rank: %d (+%d)", best, curRank, upgradesDone))
    end
end

