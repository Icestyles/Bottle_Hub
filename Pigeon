-- 🏰 BACKGROUND RUNNER 1: AUTO START DUNGEON (Solo with 15s Countdown)
-- ═══════════════════════════════════════════════════════════════════
local countdownRemaining = 0
local isCountingDown = false

task.spawn(function()
    while true do
        task.wait(1)

        -- Real-time update of Torment progress label
        if TormentTrackerLabel then
            pcall(function()
                local best, maxUnlocked = getTormentProgress()
                TormentTrackerLabel:SetText(string.format("Torment Best: Tier %d | Unlocked: Tier %d", best, maxUnlocked))
            end)
        end

        local inRun = LocalPlayer and LocalPlayer:GetAttribute("PBInRun") == true
        local inBattle = LocalPlayer and (LocalPlayer:GetAttribute("InTurnBattle") == true or LocalPlayer:GetAttribute("PlatformBattleActive") == true)

        if DungeonConfig.AutoStartDungeon and RPGCommand then
            local char = LocalPlayer and LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if not inRun and not inBattle and hrp then
                -- Reset Normal Mode Single-Act tracking when confirmed in lobby
                NormalActBossDefeated = false
                NormalActReturningHome = false
                CurrentCombatIsBoss = false

                if not isCountingDown then
                    isCountingDown = true
                    countdownRemaining = math.max(1, tonumber(DungeonConfig.StartDelay) or 15)
                end

                if DungeonStatusLabel then
                    DungeonStatusLabel:SetText(string.format("Auto Starting in: %ds (Toggle OFF to Cancel)", countdownRemaining))
                end

                countdownRemaining = countdownRemaining - 1

                if countdownRemaining <= 0 then
                    isCountingDown = false
                    local payload = nil
                    local mode = DungeonConfig.DungeonMode

                    if mode == "Normal" then
                        payload = {
                            action = "solo",
                            difficulty = string.lower(tostring(DungeonConfig.NormalDifficulty or "normal")),
                            startAct = math.clamp(tonumber(DungeonConfig.StartAct) or 1, 1, 10)
                        }
                    elseif mode == "Torment" then
                        local chosenTier = getTargetTormentTier()
                        payload = {
                            action = "solo",
                            difficulty = "torment" .. tostring(chosenTier),
                            startAct = 1
                        }
                    elseif mode == "Event (Haunted Harvest)" or mode == "Event" then
                        payload = {
                            action = "solo",
                            difficulty = "haunted",
                            startAct = 1
                        }
                    end

                    if payload then
                        if DungeonStatusLabel then
                            DungeonStatusLabel:SetText("Launching Run...")
                        end
                        pcall(function()
                            RPGCommand:FireServer("RunLobby", payload)
                        end)
                        task.wait(3)
                    end
                end
            else
                isCountingDown = false
                countdownRemaining = 0
                if DungeonStatusLabel then
                    if inBattle then
                        DungeonStatusLabel:SetText("Status: In Combat")
                    elseif inRun then
                        DungeonStatusLabel:SetText("Status: In Dungeon Run")
                    else
                        DungeonStatusLabel:SetText("Status: Waiting for Character / Lobby...")
                    end
                end
            end
        else
            isCountingDown = false
            countdownRemaining = 0
            if DungeonStatusLabel then
                if inBattle then
                    DungeonStatusLabel:SetText("Status: In Combat")
                elseif inRun then
                    DungeonStatusLabel:SetText("Status: In Dungeon Run")
                else
                    DungeonStatusLabel:SetText("Status: Idle (Auto Start OFF)")
                end
            end
        end
    end
end)

