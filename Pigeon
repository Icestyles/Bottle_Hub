local function matchesSecretBoss(choice, targetBoss)
    if type(choice) ~= "table" then return false end
    local title = string.lower(tostring(choice.title or choice.name or choice.preview or choice.boss or ""))
    local cType = string.lower(tostring(choice.type or choice.kind or ""))
    local rarity = string.lower(tostring(choice.rarity or ""))

    local isSecretNode = cType == "secret" or rarity == "secret" or string.find(title, "secret", 1, true) ~= nil

    local rawTarget = targetBoss or "Randomly"
    local target = (type(rawTarget) == "table" and rawTarget[1]) or tostring(rawTarget or "Randomly")

    if target == "Randomly" or target == "Any Secret Boss" then
        if isSecretNode then return true end
        for _, b in ipairs(SecretBossList) do
            if b ~= "Randomly" and b ~= "Any Secret Boss" and string.find(title, string.lower(b), 1, true) then
                return true
            end
        end
        return false
    else
        local targetLower = string.lower(target)
        return string.find(title, targetLower, 1, true) ~= nil
    end
end

local function normalizeNodeType(choice)
    if type(choice) ~= "table" then return "fight" end
    local rawType = string.lower(tostring(choice.type or choice.kind or ""))
    local title = string.lower(tostring(choice.title or choice.name or ""))

    -- 1. Direct or Alias Mapping:
    if rawType == "camp" or rawType == "rest" or string.find(rawType, "rest", 1, true)
        or string.find(title, "camp", 1, true) or string.find(title, "rest", 1, true) then
        return "rest"
    elseif rawType == "scout" or rawType == "treasure" or string.find(rawType, "treasure", 1, true)
        or string.find(title, "treasure", 1, true) or string.find(title, "chest", 1, true) then
        return "treasure"
    elseif rawType == "elite" or string.find(rawType, "elite", 1, true)
        or string.find(title, "elite", 1, true) then
        return "elite"
    elseif rawType == "mystery" or rawType == "shrine" or string.find(rawType, "mystery", 1, true)
        or string.find(title, "mystery", 1, true) or string.find(title, "shrine", 1, true) or string.find(title, "event", 1, true) then
        return "mystery"
    elseif rawType == "boss" or string.find(rawType, "boss", 1, true) or string.find(title, "boss", 1, true) then
        return "boss"
    elseif rawType == "retreat" or rawType == "dungeonreturn" or string.find(rawType, "retreat", 1, true)
        or string.find(title, "retreat", 1, true) or string.find(title, "turn back", 1, true) then
        return "retreat"
    end
    return "fight"
end

local function selectBestNodeChoice(choices)
    if type(choices) ~= "table" or #choices == 0 then return 1 end

    -- 1. Secret Boss Override: If enabled and matches, pick immediately!
    if DungeonConfig.Priority_SecretBoss then
        local matchedBosses = {}
        for idx, choice in ipairs(choices) do
            if matchesSecretBoss(choice, DungeonConfig.Target_SecretBoss) then
                table.insert(matchedBosses, idx)
            end
        end
        if #matchedBosses > 0 then
            return matchedBosses[1]
        end
    end

    -- 2. Preferred Node Choice: If set and found in choices, pick it 100%!
    local rawPref = DungeonConfig.PreferredNode
    local preferred = (type(rawPref) == "table" and rawPref[1]) or tostring(rawPref or "None")
    local prefLower = string.lower(string.match(tostring(preferred), "^%s*(%a+)") or "none")

    if prefLower ~= "none" and prefLower ~= "" then
        for idx, choice in ipairs(choices) do
            local normalized = normalizeNodeType(choice)
            local nodeText = string.lower(tostring(choice.kind or choice.type or choice.name or choice.title or ""))
            if normalized == prefLower or string.find(nodeText, prefLower, 1, true) then
                return idx
            end
        end
    end

    -- 3. Deterministic Priority Fallback Hierarchy (NO RANDOM PICKING!):
    -- When the preferred node did not roll in this round's choices, pick according to safe priority
    local fallbackRanks = {
        treasure = 1,
        mystery = 2,
        rest = 3,
        fight = 4,
        elite = 5,
        retreat = 6
    }

    local bestIdx = 1
    local bestRank = 999
    for idx, choice in ipairs(choices) do
        local nType = normalizeNodeType(choice)
        local rank = fallbackRanks[nType] or 4
        if rank < bestRank then
            bestRank = rank
            bestIdx = idx
        end
    end

    return bestIdx
end

local function triggerAutoReplay(info)
    if not DungeonConfig.AutoReplay or not RPGCommand then return end
    task.delay(1.2, function()
        if DungeonConfig.DungeonMode == "Torment" then
            local curTier = tonumber(info and (info.tier or info.tormentTier)) or DungeonConfig.TormentTier or 1
            if DungeonConfig.ReplayMode == "replayNext" then
                RPGCommand:FireServer("RunLobby", { action = "replayNext", tier = curTier + 1 })
            else
                RPGCommand:FireServer("RunLobby", { action = "replay" })
            end
        else
            -- Normal / Event Dungeons: Preserve and replay the exact Act/Stage (e.g. Act 9)!
            local currentAct = tonumber(info and (info.startAct or info.act)) or LastPlayedAct or DungeonConfig.StartAct or 1
            local diff = string.lower(tostring((info and info.difficulty) or DungeonConfig.NormalDifficulty or "normal"))

            if DungeonConfig.ReplayMode == "replay" then
                -- Replay the SAME Act / Stage that was just played
                RPGCommand:FireServer("RunLobby", {
                    action = "solo",
                    difficulty = diff,
                    startAct = currentAct
                })
            else
                -- "replayNext": progress to next Act (capped at 10)
                local nextAct = math.min(10, currentAct + 1)
                RPGCommand:FireServer("RunLobby", {
                    action = "solo",
                    difficulty = diff,
                    startAct = nextAct
                })
            end
        end
    end)
end

