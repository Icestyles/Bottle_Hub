local function getPetRarity(pet)
    if not pet then return "Common" end

    -- 1. Direct rarity attribute
    local rawRarity = pet.rarity or pet.Rarity or pet.tier or pet.Tier
    if rawRarity and rawRarity ~= "" then
        local s = tostring(rawRarity)
        return string.upper(string.sub(s, 1, 1)) .. string.lower(string.sub(s, 2))
    end

    -- 2. Lookup in PetConfigMod definitions
    local kind = pet.kind or pet.name or pet.type or pet.itemId or pet.id or ""
    if PetConfigMod and PetConfigMod.Pets and PetConfigMod.Pets[kind] then
        local def = PetConfigMod.Pets[kind]
        if def.rarity then
            local s = tostring(def.rarity)
            return string.upper(string.sub(s, 1, 1)) .. string.lower(string.sub(s, 2))
        end
    end

    -- 3. String name heuristic
    local sKind = tostring(kind)
    for _, r in ipairs({ "Legendary", "Epic", "Rare", "Uncommon", "Common" }) do
        if string.find(sKind, r, 1, true) then
            return r
        end
    end

    return "Common"
end

sweepAndReleasePets = function()
    if not EggConfig.AutoRelease or not RPGCommand then return end
    local pets, activePet = getProfilePets()
    if not pets or type(pets) ~= "table" then return end

    local activePetId = nil
    if type(activePet) == "string" or type(activePet) == "number" then
        activePetId = tostring(activePet)
    elseif type(activePet) == "table" then
        activePetId = tostring(activePet.id or activePet.petId or activePet.uid or "")
    end

    local petsToRelease = {}

    for key, pet in pairs(pets) do
        local petTable = type(pet) == "table" and pet or nil
        local petId = petTable and (petTable.id or petTable.petId or petTable.uid or key) or tostring(key)
        petId = tostring(petId)

        -- 1. Strictly protect equipped or active pet
        local isEquipped = (petId == activePetId)
            or (petTable and (petTable.equipped == true or petTable.active == true or petTable.isEquipped == true))

        -- 2. Strictly respect user lock
        local isLocked = petTable and (petTable.locked == true)

        if not isEquipped and not isLocked and petId ~= "" then
            local rarity = getPetRarity(petTable)
            if EggConfig.ReleaseRarities[rarity] == true then
                table.insert(petsToRelease, petId)
            end
        end
    end

    if #petsToRelease > 0 then
        task.spawn(function()
            for _, pId in ipairs(petsToRelease) do
                if not EggConfig.AutoRelease then break end
                pcall(function()
                    RPGCommand:FireServer("Ranch", {
                        action = "release",
                        petId = pId
                    })
                end)
                task.wait(0.25)
            end
        end)
    end
end

