    end

    local ok, Menu = pcall(require, mod)
    if not ok or type(Menu) ~= "table" or not Menu.Update then
        return false
    end

    if Menu.__bhHooked then
        NativeMenuHooked = true
        return true
    end
    Menu.__bhHooked = true

    local oldUpdate = Menu.Update
    Menu.Update = function(self, snapshot)
        local res = oldUpdate(self, snapshot)
        CombatState.ActiveMenu = self
        CombatState.CurrentBattle = snapshot

        if CombatConfig.AutoTurn and type(snapshot) == "table" and snapshot.canAct == true then
            dispatchTurnAction(self, snapshot, "MenuUpdate")
        end

        return res
    end

    NativeMenuHooked = true
    return true
end

