            end

            local round = tonumber(stateOrPayload.round) or 1
            local mode = tostring(stateOrPayload.difficulty or DungeonConfig.DungeonMode or "")
            local act = tonumber(stateOrPayload.act or stateOrPayload.startAct or LastPlayedAct or DungeonConfig.StartAct) or 1
            local tier = tonumber(stateOrPayload.tier or stateOrPayload.tormentLevel or DungeonConfig.TormentTier) or 1

            local text = ""
            if string.find(string.lower(mode), "torment", 1, true) or stateOrPayload.torment then
                text = string.format("📍 Torment.lvl%d Stage %d", tier, round)
            elseif string.find(string.lower(mode), "spooky", 1, true) or string.find(string.lower(mode), "halloween", 1, true) then
                text = string.format("📍 Spooky Stage %d", round)
