local function isNormalActFinished(state)
    if DungeonConfig.DungeonMode ~= "Normal" then return false end
    if not state or type(state) ~= "table" then return false end

    -- Continuous Progression Mode: Do NOT exit on Act transition! Allow playing through Acts continuously.
    if DungeonConfig.ActProgression == "Continuous" then
        if not DungeonConfig.AutoReplay and (state.phase == "completed" or state.phase == "victory" or state.phase == "ended" or state.active == false) then
            return true
        end
        return false
    end

    -- Single Act (Farm) Mode: Exit as soon as target Act is completed and next Act's route choice begins
    local targetAct = math.clamp(tonumber(DungeonConfig.StartAct) or 1, 1, 10)
    local curAct = tonumber(state.act or state.startAct) or targetAct

    -- 1. Reached the next Act's Route Selection (phase == "choose") -> Exit to prevent advancing Act!
    if curAct > targetAct and state.phase == "choose" then
        return true
    end

    -- 2. If run ended/completed AND AutoReplay is OFF, return home safely
    if not DungeonConfig.AutoReplay and (state.phase == "completed" or state.phase == "victory" or state.phase == "ended" or state.active == false) then
        return true
    end

    return false
end

-- Helper: Dispatch all Return-to-Lobby packets and click Return GUI buttons
local function dispatchReturnLobbySequence(state)
    local runId = (state and state.id) or ""
    local round = (state and state.round) or 1
    local phase = (state and state.phase) or "choose"

    -- Step 1: Fire RunAction abandon at choose phase
    if RPGCommand and runId ~= "" then
        pcall(function()
            RPGCommand:FireServer("RunAction", {
                action = "abandon",
                phase = phase,
                round = round,
                runId = runId
            })
        end)
    end

    task.wait(0.15)

    -- Step 2: Fire RunLobby abandon
    if RPGCommand then
        pcall(function()
            RPGCommand:FireServer("RunLobby", { action = "abandon" })
        end)
    end

    task.wait(0.15)

    -- Step 3: Fire RunGoHome { now = true }
    if RPGCommand then
        pcall(function()
            RPGCommand:FireServer("RunGoHome", { now = true })
        end)
    end

    -- Step 4: GUI Fallback (Click Return Home / Continue / Return to the Road buttons if visible)
    local pg = getPlayerGui(false)
    if pg then
        for _, desc in ipairs(pg:GetDescendants()) do
            if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                local text = string.upper(tostring(desc.Name .. " " .. (desc:IsA("TextButton") and desc.Text or "")))
                if string.find(text, "RETURN HOME", 1, true)
                    or string.find(text, "HEAD HOME", 1, true)
                    or string.find(text, "RETURN TO CASTLE", 1, true)
                    or string.find(text, "TURN BACK", 1, true)
                    or string.find(text, "LEAVE DUNGEON", 1, true)
                    or string.find(text, "RETURN TO THE ROAD", 1, true) then
                    if desc.Visible and desc.Active and firesignal then
                        pcall(firesignal, desc.Activated)
                        pcall(firesignal, desc.MouseButton1Click)
                    end
                end
            end
        end
    end
end

local LatestRunState = nil

local function performSafeReturnHome(state)
    if state and type(state) == "table" then
        LatestRunState = state
    end
    if NormalActReturningHome then return end
    NormalActReturningHome = true

    if DungeonStatusLabel then
        DungeonStatusLabel:SetText("Act Cleared! Returning to Lobby...")
    end

    task.spawn(function()
        local attempt = 1
        while NormalActReturningHome do
            local inRun = LocalPlayer and LocalPlayer:GetAttribute("PBInRun") == true
            if not inRun and attempt > 1 then
                -- Confirmed back in Lobby! Reset state lock.
                NormalActReturningHome = false
                if DungeonStatusLabel then
                    DungeonStatusLabel:SetText("Status: Returned to Lobby!")
                end
                break
            end

            if DungeonStatusLabel then
                DungeonStatusLabel:SetText(string.format("Returning to Lobby (Attempt #%d)...", attempt))
            end

            -- Claim any lingering chests/victory screens before firing return sequence
            autoClaimDungeonChests()
            dispatchReturnLobbySequence(LatestRunState or state)

            attempt = attempt + 1

            -- ⏱️ Fallback Loop: Wait 5 seconds, then re-verify if still stuck in dungeon
            task.wait(5)

            if LocalPlayer and LocalPlayer:GetAttribute("PBInRun") ~= true then
                NormalActReturningHome = false
                break
            end
        end
    end)
end

updateStageDisplay = function(stateOrPayload)
    if not StageBadge then return end
    task.defer(function()
        pcall(function()
            if not stateOrPayload or type(stateOrPayload) ~= "table" then
                StageBadge:SetText("📍 Lobby (Idle)")
