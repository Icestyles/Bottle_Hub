local function extractProfileFromMemory()
    if LatestProfile and (type(LatestProfile.inventory) == "table" or type(LatestProfile.gearBag) == "table") then
        return LatestProfile
    end

    -- 1. Try getconnections on RPGState.OnClientEvent upvalues
    if getconnections and RPGState then
        pcall(function()
            for _, conn in ipairs(getconnections(RPGState.OnClientEvent)) do
                local fn = conn.Function
                if fn and getupvalues then
                    local uvs = getupvalues(fn)
                    for _, uv in pairs(uvs) do
                        if type(uv) == "table" then
                            if uv.profile and type(uv.profile) == "table" and (type(uv.profile.inventory) == "table" or type(uv.profile.gearBag) == "table") then
                                LatestProfile = uv.profile
                                return
                            elseif (type(uv.inventory) == "table" or type(uv.gearBag) == "table") and (uv.gold ~= nil or uv.valor ~= nil or uv.lineage ~= nil or uv.userId ~= nil) then
                                LatestProfile = uv
                                return
                            end
                            if uv.pixelGear and type(uv.pixelGear) == "table" and uv.pixelGear.profile and (type(uv.pixelGear.profile.inventory) == "table" or type(uv.pixelGear.profile.gearBag) == "table") then
                                LatestProfile = uv.pixelGear.profile
                                return
                            end
                        end
                    end
                end
            end
        end)
        if LatestProfile and (type(LatestProfile.inventory) == "table" or type(LatestProfile.gearBag) == "table") then
            return LatestProfile
        end
    end

    -- 2. Try getgc(true) scanning
    if getgc then
        pcall(function()
            local gc = getgc(true)
            for _, tbl in ipairs(gc) do
                if type(tbl) == "table" then
                    if (type(rawget(tbl, "inventory")) == "table" or type(rawget(tbl, "gearBag")) == "table") and (rawget(tbl, "gold") ~= nil or rawget(tbl, "valor") ~= nil or rawget(tbl, "gems") ~= nil or rawget(tbl, "lineage") ~= nil) then
                        LatestProfile = tbl
                        return
                    elseif type(rawget(tbl, "profile")) == "table" and (type(rawget(tbl.profile, "inventory")) == "table" or type(rawget(tbl.profile, "gearBag")) == "table") then
                        LatestProfile = tbl.profile
                        return
                    end
                end
            end
        end)
        if LatestProfile and (type(LatestProfile.inventory) == "table" or type(LatestProfile.gearBag) == "table") then
            return LatestProfile
        end
    end

    -- 3. Fallback: Request profile from server if ProfileRequest exists
    local pReq = Remotes and Remotes:FindFirstChild("ProfileRequest")
    if pReq then
        pcall(function()
            local res = pReq:InvokeServer("GetProfile") or pReq:InvokeServer("Profile") or pReq:InvokeServer()
            if type(res) == "table" then
                local p = res.profile or res
                if type(p.inventory) == "table" or type(p.gearBag) == "table" then
                    LatestProfile = p
                end
            end
        end)
        if LatestProfile and (type(LatestProfile.inventory) == "table" or type(LatestProfile.gearBag) == "table") then
            return LatestProfile
        end
    end

    return LatestProfile
end

