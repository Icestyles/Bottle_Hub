local RarityLevelMap = {
    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5
}

local function syncNativeAutoSell()
    if not RPGCommand then return end
    local level = 0
    if AutoSellConfig.Enabled then
        for _, name in ipairs({ "Legendary", "Epic", "Rare", "Uncommon", "Common" }) do
            if AutoSellConfig.Tiers[name] then
                level = RarityLevelMap[name] or 0
                break
            end
        end
    end
    pcall(function()
        RPGCommand:FireServer("Settings", { key = "PBAutoSell", value = level })
    end)
end

sweepAndSellBagGears = function()
    if not AutoSellConfig.Enabled or not RPGCommand then return end
    local gearBag, equippedGear = getProfileGearBag()
    if not gearBag or type(gearBag) ~= "table" then return end

    -- Whitelist all equipped gears to guarantee they are never touched
    local equippedUids = {}
    if type(equippedGear) == "table" then
        for _, g in pairs(equippedGear) do
            if type(g) == "table" and g.uid then
                equippedUids[tostring(g.uid)] = true
            elseif type(g) == "string" then
                equippedUids[g] = true
            end
        end
    end

    local uidsToSell = {}
    for _, item in pairs(gearBag) do
        if type(item) == "table" and item.uid then
            local uid = tostring(item.uid)
            -- 1. Never sell equipped or worn items
            if not equippedUids[uid] and item.worn ~= true and item.equipped ~= true then
                -- 2. Strictly respect user lock
                if item.locked ~= true then
                    -- 3. Protect upgraded / honed gear (+1+)
                    local hone = tonumber(item.plus) or tonumber(item.hone) or 0
                    if not (AutoSellConfig.ProtectUpgraded and hone > 0) then
                        -- 4. Check if rarity matches user's chosen tiers
                        local rawRarity = tostring(item.rarity or item.Rarity or "")
                        if rawRarity == "" and GearConfigMod and GearConfigMod.Items and item.base then
                            local baseDef = GearConfigMod.Items[item.base]
                            if baseDef and baseDef.rarity then
                                rawRarity = tostring(baseDef.rarity)
                            end
                        end
                        if rawRarity == "" then rawRarity = "Common" end
                        local normRarity = string.upper(string.sub(rawRarity, 1, 1)) .. string.lower(string.sub(rawRarity, 2))

                        if AutoSellConfig.Tiers[normRarity] == true then
                            table.insert(uidsToSell, uid)
                        end
                    end
                end
            end
        end
    end

    if #uidsToSell > 0 then
        task.spawn(function()
            for i = 1, #uidsToSell, 20 do
                local batch = {}
                for j = i, math.min(i + 19, #uidsToSell) do
                    table.insert(batch, uidsToSell[j])
                end
                pcall(function()
                    RPGCommand:FireServer("GearSellMany", { uids = batch })
                end)
                task.wait(0.25)
            end
        end)
    end
end

