-- ============================================================================
local HOP_CACHE_FILE = "BottleLib_HopCache.json"
BottleLib._HopCacheInMemory = {}
BottleLib._IsHopping = false

local function loadHopCache()
    local cache = {}
    if typeof(readfile) == "function" and typeof(isfile) == "function" then
        local ok, content = pcall(function()
            if isfile(HOP_CACHE_FILE) then
                return readfile(HOP_CACHE_FILE)
            end
        end)
        if ok and typeof(content) == "string" and #content > 0 then
            local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
            if ok2 and typeof(data) == "table" then
                cache = data
            end
        end
    end
    if not next(cache) and next(BottleLib._HopCacheInMemory) then
        cache = BottleLib._HopCacheInMemory
    end
    return cache
end

local function saveHopCache(cache)
    BottleLib._HopCacheInMemory = cache
    if typeof(writefile) == "function" then
        pcall(function()
            writefile(HOP_CACHE_FILE, HttpService:JSONEncode(cache))
        end)
    end
end

function BottleLib:GetHopBlacklist(placeId)
    placeId = tostring(placeId or game.PlaceId)
    local cache = loadHopCache()
    local placeCache = cache[placeId] or {}
    local activeBlacklist = {}
    local now = os.time()
    for jid, expireTime in pairs(placeCache) do
        if typeof(expireTime) == "number" and expireTime > now then
            activeBlacklist[jid] = expireTime
        end
    end
    return activeBlacklist
end

function BottleLib:ClearHopBlacklist(placeId)
    placeId = tostring(placeId or game.PlaceId)
    local cache = loadHopCache()
    cache[placeId] = {}
    saveHopCache(cache)
    BottleLib:Notify("Server hop blacklist cleared.")
end

function BottleLib:CheckHopArrival(windowObj, windowConfig)
    if BottleLib._HasCheckedArrival then return end
    BottleLib._HasCheckedArrival = true

    task.spawn(function()
        task.wait(1.5) -- Allow network connection & ping telemetry to stabilize
        local cache = loadHopCache()
        local pending = cache["_PendingHop"]
        if not pending or typeof(pending) ~= "table" then return end

        local now = os.time()
        -- Invalidate if older than 120 seconds
        if not pending.Timestamp or (now - pending.Timestamp) > 120 then
            cache["_PendingHop"] = nil
            saveHopCache(cache)
            return
        end

        local currentJob = game.JobId or ""
        local prevJob = pending.PreviousJobId or ""
        local maxPing = tonumber(pending.MaxPing or (windowConfig and windowConfig.ServerHopMaxPing) or 130)
        local retries = tonumber(pending.Retries or 0)
        local rawMode = pending.TargetMode or "Nearest"
        local isNearest = (rawMode == "Nearest" or string.find(rawMode:lower(), "nearest") ~= nil)

        -- 1. Anti-Same-Server Guard: Did Roblox matchmaker place us back into the exact same server instance?
        if #currentJob > 0 and currentJob == prevJob then
            cache["_PendingHop"] = nil
            saveHopCache(cache)

            if retries < 3 then
                BottleLib:Notify(string.format("⚠️ Reconnected to same server. Rerolling nearest regional server (attempt %d/3)...", retries + 1))
                task.wait(1.5)
                BottleLib:ServerHop({
                    Mode = rawMode,
                    MaxPing = maxPing,
                    Retries = retries + 1
                })
            else
                BottleLib:Notify("ℹ️ No alternative regional servers available right now.")
            end
            return
        end

        -- 2. Latency Guard & Auto-Bouncer: For "Nearest" mode, verify ping is in Singapore/Tokyo range
        if isNearest then
            local currentPing = 0
            pcall(function()
                currentPing = math.floor(player:GetNetworkPing() * 1000)
            end)
            if currentPing <= 0 then
                pcall(function()
                    local stats = game:GetService("Stats")
                    local net = stats and stats:FindFirstChild("Network")
                    local sItem = net and net:FindFirstChild("ServerStatsItem")
                    local dPing = sItem and sItem:FindFirstChild("Data Ping")
                    if dPing then currentPing = math.floor(dPing:GetValue()) end
                end)
            end

            if currentPing > maxPing and retries < 3 then
                -- Player landed in a far-away data center (US/EU with 250ms+)
                BottleLib:Notify(string.format("⚠️ High ping detected (%dms > %dms). Bouncing to Singapore/Tokyo (attempt %d/3)...", currentPing, maxPing, retries + 1))
                
                -- Blacklist this high-ping server
                local placeKey = tostring(game.PlaceId)
                local placeCache = cache[placeKey] or {}
                if #currentJob > 0 then
                    placeCache[currentJob] = now + ((windowConfig and windowConfig.ServerHopBlacklistDuration) or 600)
                end
                cache[placeKey] = placeCache
                cache["_PendingHop"] = nil
                saveHopCache(cache)

                task.wait(1.5)
                BottleLib:ServerHop({
                    Mode = "Nearest",
                    MaxPing = maxPing,
                    Retries = retries + 1
                })
                return
            else
                if currentPing > 0 then
                    BottleLib:Notify(string.format("🟢 Regional Server connected! Ping: %dms (Region: Asia/Nearest)", currentPing))
                else
                    BottleLib:Notify("🟢 Connected to nearest server successfully!")
                end
            end
        else
            BottleLib:Notify(string.format("🟢 Server hop completed (Mode: %s)!", rawMode))
        end

        -- Cleanup pending flag after successful arrival
        cache["_PendingHop"] = nil
        saveHopCache(cache)
    end)
end

function BottleLib:ServerHop(options)
    if BottleLib._IsHopping then
        BottleLib:Notify("Server hop already in progress...")
        return
    end

    options = options or {}
    local rawMode           = options.Mode or options.Priority or "Nearest"
    local blacklistDuration = options.BlacklistDuration or 600 -- 10 mins (in seconds)
    local maxPages          = math.clamp(options.MaxPages or 3, 1, 10)
    local minPlayers        = options.MinPlayers or 1
    local playerMargin      = options.PlayerMargin or 1
    local maxPing           = tonumber(options.MaxPing) or 130
    local placeId           = options.PlaceId or game.PlaceId
    local placeKey          = tostring(placeId)
    local retries           = tonumber(options.Retries) or 0

    local isNearestMode = (rawMode == "Nearest" or string.find(rawMode:lower(), "nearest") ~= nil or string.find(rawMode:lower(), "low ping") ~= nil)
    local mode = isNearestMode and "Nearest" or (string.find(rawMode:lower(), "lowest") and "LowestPlayer" or (string.find(rawMode:lower(), "highest") and "HighestPlayer" or "Random"))

    BottleLib._IsHopping = true
    task.spawn(function()
        local function finishHop(success, msg)
            BottleLib._IsHopping = false
            if msg then BottleLib:Notify(msg) end
        end

        local cache = loadHopCache()
        local placeCache = cache[placeKey] or {}
        local now = os.time()

        -- Prune expired entries
        local prunedPlaceCache = {}
        local activeBlacklistCount = 0
        for jid, exp in pairs(placeCache) do
            if typeof(exp) == "number" and exp > now then
                prunedPlaceCache[jid] = exp
                activeBlacklistCount = activeBlacklistCount + 1
            end
        end

        -- Always ensure current server is blacklisted
        if game.JobId and #game.JobId > 0 then
            prunedPlaceCache[game.JobId] = now + blacklistDuration
        end
        cache[placeKey] = prunedPlaceCache

        -- Store _PendingHop for arrival verification
        cache["_PendingHop"] = {
            PreviousJobId = game.JobId or "",
            PlaceId = placeId,
            TargetMode = mode,
            MaxPing = maxPing,
            Timestamp = now,
            Retries = retries
        }
        saveHopCache(cache)

        -- ====================================================================
        -- ENGINE 1: Native Regional Matchmaker (For "Nearest" - Low Ping Asia)
        -- ====================================================================
        if isNearestMode then
            BottleLib:Notify("Routing to nearest regional server (Singapore / Tokyo low ping)...")
            task.wait(0.5)

            local okTeleport, err = pcall(function()
                TeleportService:Teleport(placeId, player)
            end)

            if not okTeleport then
                finishHop(false, "Regional teleport failed: " .. tostring(err))
            end
            return
        end

        -- ====================================================================
        -- ENGINE 2: Global Instance Pool (For "LowestPlayer", "HighestPlayer", "Random")
        -- ====================================================================
        if activeBlacklistCount > 0 then
            BottleLib:Notify(string.format("Scanning servers (excluding %d in blacklist)...", activeBlacklistCount))
        else
            BottleLib:Notify("Scanning servers for optimal connection...")
        end

        local httpReq = (syn and syn.request) or (http and http.request) or http_request or request
        local cursor = ""
        local candidateServers = {}

        -- Fetch up to maxPages of servers
        for page = 1, maxPages do
            local sortParam = (mode == "LowestPlayer" and "Asc") or "Desc"
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=%s&limit=100%s",
                tostring(placeId),
                sortParam,
                (cursor ~= "" and ("&cursor=" .. cursor) or "")
            )

            local ok, res
            if httpReq then
                ok, res = pcall(function() return httpReq({Url = url, Method = "GET"}) end)
            else
                ok, res = pcall(function()
                    return { Body = game:HttpGet(url) }
                end)
            end

            if not ok or not res or not res.Body then
                break
            end

            local okJson, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not okJson or not decoded or not decoded.data then
                break
            end

            for _, s in ipairs(decoded.data) do
                local sId = s.id
                local playing = tonumber(s.playing) or 0
                local maxP = tonumber(s.maxPlayers) or 0

                -- Filter conditions
                local notCurrent = (sId ~= game.JobId)
                local notBlacklisted = (prunedPlaceCache[sId] == nil or prunedPlaceCache[sId] <= now)
                local notFull = (playing <= (maxP - playerMargin))
                local notEmpty = (playing >= minPlayers)

                if notCurrent and notBlacklisted and notFull and notEmpty then
                    table.insert(candidateServers, s)
                end
            end

            cursor = decoded.nextPageCursor or ""
            if cursor == "" then break end
            task.wait(0.2) -- gentle rate-limit buffer
        end

        -- Handle case where candidate pool is empty because all are blacklisted
        if #candidateServers == 0 then
            if activeBlacklistCount > 0 then
                BottleLib:Notify("All candidate servers blacklisted. Resetting history & retrying...")
                cache[placeKey] = { [game.JobId] = now + blacklistDuration }
                saveHopCache(cache)
                task.wait(1)
                BottleLib._IsHopping = false
                BottleLib:ServerHop({
                    Mode = mode,
                    BlacklistDuration = blacklistDuration,
                    MaxPages = maxPages,
                    MinPlayers = minPlayers,
                    MaxPing = maxPing,
                    Retries = retries + 1
                })
                return
            else
                BottleLib:Notify("No alternative servers found. Retrying with regional matchmaker...")
                local ok, err = pcall(function() TeleportService:Teleport(placeId, player) end)
                if not ok then finishHop(false, "Teleport failed: " .. tostring(err)) end
                return
            end
        end

        -- Selection Strategy based on Mode
        local chosenServer = nil
        if mode == "LowestPlayer" then
            table.sort(candidateServers, function(a, b)
                return (a.playing or 0) < (b.playing or 0)
            end)
            chosenServer = candidateServers[1]
        elseif mode == "HighestPlayer" then
            table.sort(candidateServers, function(a, b)
                return (a.playing or 0) > (b.playing or 0)
            end)
            chosenServer = candidateServers[1]
        else -- "Random"
            chosenServer = candidateServers[math.random(1, #candidateServers)]
        end

        if not chosenServer then
            finishHop(false, "Failed to pick server.")
            return
        end

        -- Record chosen server in blacklist before teleporting
        prunedPlaceCache[chosenServer.id] = now + blacklistDuration
        cache[placeKey] = prunedPlaceCache
        saveHopCache(cache)

        BottleLib:Notify(string.format("Joining server [%d/%d players] (Mode: %s)...", 
            chosenServer.playing or 0, 
            chosenServer.maxPlayers or 0, 
            mode
        ))

        task.wait(0.5)
        local okTeleport, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, chosenServer.id, player)
        end)

        if not okTeleport then
            finishHop(false, "Teleport failed: " .. tostring(err))
        end
    end)
end

-- Teleport Failure Protection: automatically blacklist and retry if target server rejects
pcall(function()
    TeleportService.TeleportInitFailed:Connect(function(failedPlayer, result, errorMessage)
        if failedPlayer == player then
            BottleLib:Notify("Teleport rejected (" .. tostring(result.Name) .. "). Retrying hop...")
            task.wait(2)
            BottleLib:ServerHop()
        end
    end)
end)

