-- Helper: Marquee Text Label
local function CreateMarqueeLabel(parent, text, col, fnt, sz, allowScroll, lo)
    local container = Instance.new("Frame", parent)
    container.LayoutOrder = lo or 0
    container.Size = UDim2.new(1, 0, 0, sz + 4)
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true
    container.ZIndex = (parent.ZIndex or 5)

    local l = Instance.new("TextLabel", container)
    l.Size = UDim2.new(1, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = text or ""
    l.TextColor3 = col or Color3.fromRGB(240, 240, 240)
    l.Font = fnt or Enum.Font.GothamMedium
    l.TextSize = sz or 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.ZIndex = (container.ZIndex or 5) + 1

    if allowScroll then
        task.spawn(function()
            task.wait(0.3)
            if not l.Parent then return end
            if l.TextBounds.X > container.AbsoluteSize.X then
                l.Size = UDim2.new(0, l.TextBounds.X, 1, 0)
                local dist = l.TextBounds.X - container.AbsoluteSize.X + 12
                while container and container.Parent do
                    task.wait(2.5)
                    if not container or not container.Parent then break end
                    local tw = TweenService:Create(l, TweenInfo.new(math.max(dist / 16, 1), Enum.EasingStyle.Linear), {Position = UDim2.new(0, -dist, 0, 0)})
                    tw:Play()
                    task.wait(math.max(dist / 16, 1) + 1)
                    if l and l.Parent then l.Position = UDim2.new(0, 0, 0, 0) end
                end
            end
        end)
    else
        l.TextTruncate = Enum.TextTruncate.AtEnd
    end
    return l, container
end

