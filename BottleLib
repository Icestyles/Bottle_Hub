local semanticPrefixes   = {"Client", "Local", "System", "HUD", "Custom", "Core", "View", "Interface"}
local semanticCategories = {"Menu", "Overlay", "Display", "Action", "Status", "Module", "Widget", "Layout"}
local semanticComponents = {"Frame", "Container", "Holder", "Wrapper", "Group", "Canvas"}

local function generateNaturalName(suffixType)
    local p = semanticPrefixes[math.random(1, #semanticPrefixes)]
    local c = semanticCategories[math.random(1, #semanticCategories)]
    local s = suffixType or semanticComponents[math.random(1, #semanticComponents)]
    local tag = math.random(10, 99)
    return string.format("%s%s%s_%d", p, c, s, tag)
end

