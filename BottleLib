        fStroke.Thickness = 1
        fStroke.Transparency = 0.55

        local fLayout = Instance.new("UIListLayout", folderFrame)
        fLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local headerBtn = Instance.new("TextButton", folderFrame)
        headerBtn.Size = UDim2.new(1, 0, 0, headerH)
        headerBtn.BackgroundTransparency = 1

        if not isSubFolder then
            local accentBar = Instance.new("Frame", headerBtn)
            accentBar.Size = UDim2.new(0, 3, 1, 0)
            accentBar.Position = UDim2.new(0, 0, 0, 0)
            accentBar.BackgroundColor3 = T.Accent
            accentBar.BackgroundTransparency = 0.3
            accentBar.BorderSizePixel = 0
            Instance.new("UICorner", accentBar).CornerRadius = UDim.new(0, 4)
        end

        local arrowOpen  = "  ▼  "
        local arrowClose = "  ▶  "
        headerBtn.Text = (isSubFolder and (arrowOpen .. "<font color='#aaaaaa'>" .. folderName .. "</font>") or (arrowOpen .. folderName))
        headerBtn.RichText = true
        headerBtn.TextColor3 = T.Text
        headerBtn.Font = Enum.Font.GothamBold
        headerBtn.TextSize = headerFs
        headerBtn.TextXAlignment = Enum.TextXAlignment.Left

        local headerSep = Instance.new("Frame", folderFrame)
        headerSep.Size = UDim2.new(1, 0, 0, 1)
        headerSep.BackgroundColor3 = T.Stroke
        headerSep.BackgroundTransparency = 0.6
        headerSep.BorderSizePixel = 0

        local innerContainer = Instance.new("Frame", folderFrame)
        innerContainer.Size = UDim2.new(1, 0, 0, 0)
        innerContainer.AutomaticSize = Enum.AutomaticSize.Y
        innerContainer.BackgroundTransparency = 1
        innerContainer.ClipsDescendants = true

        local innerLayout = Instance.new("UIListLayout", innerContainer)
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Padding = UDim.new(0, isSubFolder and 4 or 6)

        local innerPad = Instance.new("UIPadding", innerContainer)
        innerPad.PaddingTop = UDim.new(0, isSubFolder and 4 or 6)
        innerPad.PaddingBottom = UDim.new(0, isSubFolder and 5 or 8)
        innerPad.PaddingLeft = UDim.new(0, (isSubFolder and 6 or 10) + indentL)
        innerPad.PaddingRight = UDim.new(0, (isSubFolder and 4 or 10) + indentR)

        local isOpen = true
        headerBtn.MouseButton1Click:Connect(function()
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            isOpen = not isOpen
            innerContainer.Visible = isOpen
            headerSep.Visible = isOpen
            local arrow = isOpen and arrowOpen or arrowClose
            headerBtn.Text = (isSubFolder and (arrow .. "<font color='#aaaaaa'>" .. folderName .. "</font>") or (arrow .. folderName))
        end)

        local FolderObj = {}
        BindUIElements(FolderObj, innerContainer, T, WindowObj, ScreenGui, GlobalOverlayClose, _depth + 1)
        return FolderObj
    end
end

-- ============================================================================
-- [5] WINDOW BUILDER (Universal Engine & Mobile Support)
-- ============================================================================
function BottleLib:CreateWindow(WindowConfig)
    BottleLib.CleanUpEvent:Fire()

    WindowConfig = WindowConfig or {}
    local titleText = WindowConfig.Title or "BottleLib UI"
    local winSize   = WindowConfig.Size or UDim2.new(0, 580, 0, 390)
    local sidebarW  = WindowConfig.SidebarWidth or 130
    local topbarH   = WindowConfig.TopbarHeight or 36
    local toggleKey = WindowConfig.ToggleKey or Enum.KeyCode.RightControl
    local autoUnlock = (WindowConfig.AutoUnlockMouse ~= false)
    local showMobileToggle = WindowConfig.MobileToggle
    if showMobileToggle == nil then
        showMobileToggle = UserInputService.TouchEnabled
    end

    local T = {
        Accent                 = WindowConfig.Accent or Color3.fromHex("#6366f1"),
        Background             = Color3.fromRGB(15, 15, 18),
        BackgroundTransparency = 0.25,
        TopbarTransparency     = 0.40,
        SidebarTransparency    = 0.45,
        Element                = Color3.fromRGB(24, 24, 28),
        ElementTransparency    = 0.40,
        ElemDark               = Color3.fromRGB(16, 16, 20),
        ElemDarkTransparency   = 0.45,
        Stroke                 = Color3.fromRGB(80, 80, 95),
        Text                   = Color3.fromRGB(245, 245, 245),
        SubText                = Color3.fromRGB(150, 150, 160),
        Success                = Color3.fromHex("#22c55e"),
        Warning                = Color3.fromHex("#eab308"),
        Danger                 = Color3.fromHex("#ef4444")
    }

    local parentGui = getGuiParent()
    if BottleLib.ActiveScreenGui and BottleLib.ActiveScreenGui.Parent then
        BottleLib.ActiveScreenGui:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = WindowConfig.GuiName or generateNaturalName("Gui")
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    protectGui(ScreenGui)
    ScreenGui.Parent = parentGui
    BottleLib.ActiveScreenGui = ScreenGui

    local GlobalOverlayClose = Instance.new("TextButton", ScreenGui)
    GlobalOverlayClose.Size = UDim2.new(1, 0, 1, 0)
    GlobalOverlayClose.BackgroundTransparency = 1
    GlobalOverlayClose.Text = ""
    GlobalOverlayClose.Visible = false
    GlobalOverlayClose.ZIndex = 70

    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Name = generateNaturalName("Frame")
    MainFrame.Size = winSize
    MainFrame.Position = UDim2.new(0.5, -winSize.X.Offset / 2, 0.5, -winSize.Y.Offset / 2)
    MainFrame.BackgroundColor3 = T.Background
    MainFrame.BackgroundTransparency = T.BackgroundTransparency
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

    local mainStroke = Instance.new("UIStroke", MainFrame)
    mainStroke.Color = T.Stroke
    mainStroke.Thickness = 1.5
    mainStroke.Transparency = 0.25

    -- Topbar
    local Topbar = Instance.new("Frame", MainFrame)
    Topbar.Size = UDim2.new(1, 0, 0, topbarH)
    Topbar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    Topbar.BackgroundTransparency = T.TopbarTransparency
    Topbar.BorderSizePixel = 0

    local TitleLbl = Instance.new("TextLabel", Topbar)
    TitleLbl.Size = UDim2.new(0, 140, 1, 0)
    TitleLbl.Position = UDim2.new(0, 14, 0, 0)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = titleText
    TitleLbl.TextColor3 = T.Text
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 13
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.TextTruncate = Enum.TextTruncate.AtEnd

    -- Window Controls
    local WinControls = Instance.new("Frame", Topbar)
    WinControls.Size = UDim2.new(0, 56, 1, 0)
    WinControls.Position = UDim2.new(1, -62, 0, 0)
    WinControls.BackgroundTransparency = 1

    local wLayout = Instance.new("UIListLayout", WinControls)
    wLayout.FillDirection = Enum.FillDirection.Horizontal
    wLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    wLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    wLayout.Padding = UDim.new(0, 6)

    local MinBtn = Instance.new("TextButton", WinControls)
    MinBtn.Size = UDim2.new(0, 24, 0, 24)
    MinBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    MinBtn.BackgroundTransparency = 0.3
    MinBtn.Text = "-"
    MinBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.TextSize = 12
    MinBtn.AutoButtonColor = false
    Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(0, 4)

    local CloseBtn = Instance.new("TextButton", WinControls)
    CloseBtn.Size = UDim2.new(0, 24, 0, 24)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    CloseBtn.BackgroundTransparency = 0.3
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 11
    CloseBtn.AutoButtonColor = false
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)

    local HeaderControls = Instance.new("Frame", Topbar)
    HeaderControls.Size = UDim2.new(1, -220, 1, 0)
    HeaderControls.Position = UDim2.new(0, 155, 0, 0)
    HeaderControls.BackgroundTransparency = 1

    local hLayout = Instance.new("UIListLayout", HeaderControls)
    hLayout.FillDirection = Enum.FillDirection.Horizontal
    hLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    hLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    hLayout.Padding = UDim.new(0, 6)

    local BodyFrame = Instance.new("Frame", MainFrame)
    BodyFrame.Position = UDim2.new(0, 10, 0, topbarH + 2)
    BodyFrame.Size = UDim2.new(1, -20, 1, -(topbarH + 12))
    BodyFrame.BackgroundTransparency = 1

    local TabSidebar = Instance.new("ScrollingFrame", BodyFrame)
    TabSidebar.Size = UDim2.new(0, sidebarW, 1, 0)
    TabSidebar.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    TabSidebar.BackgroundTransparency = T.SidebarTransparency
    TabSidebar.BorderSizePixel = 0
    TabSidebar.ScrollBarThickness = 2
    Instance.new("UICorner", TabSidebar).CornerRadius = UDim.new(0, 8)

    local sStroke = Instance.new("UIStroke", TabSidebar)
    sStroke.Color = T.Stroke
    sStroke.Thickness = 1
    sStroke.Transparency = 0.6

    local tabLayout = Instance.new("UIListLayout", TabSidebar)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Padding = UDim.new(0, 4)

    local tabPad = Instance.new("UIPadding", TabSidebar)
    tabPad.PaddingTop = UDim.new(0, 6)
    tabPad.PaddingLeft = UDim.new(0, 6)
    tabPad.PaddingRight = UDim.new(0, 6)

    local ContentArea = Instance.new("Frame", BodyFrame)
    ContentArea.Position = UDim2.new(0, sidebarW + 10, 0, 0)
    ContentArea.Size = UDim2.new(1, -(sidebarW + 10), 1, 0)
    ContentArea.BackgroundTransparency = 1

    local WindowObj = {
        Theme = T,
        ActiveDropdown = nil,
        Tabs = {},
        CurrentTab = nil,
        CloseCallbacks = {},
        Connections = {},
        IsClosed = false,
        IsClosing = false,
        IsMinimized = false
    }

    local function closeActiveDropdown()
        if WindowObj.ActiveDropdown then
            WindowObj.ActiveDropdown.Visible = false
            WindowObj.ActiveDropdown = nil
            GlobalOverlayClose.Visible = false
        end
    end

    -- Dragging Handler
    local dragging, dragStart, startPos = false, nil, nil
    local cDragBegin = Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            closeActiveDropdown()
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    local cDragChange = Topbar.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    table.insert(WindowObj.Connections, cDragBegin)
    table.insert(WindowObj.Connections, cDragChange)

    -- Window Toggle Method
    function WindowObj:Toggle(forceState)
        if self.IsClosing or self.IsClosed then return end
        closeActiveDropdown()
        local newState = (forceState ~= nil and forceState) or not MainFrame.Visible
        MainFrame.Visible = newState

        if newState and autoUnlock then
            pcall(function()
                if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                end
            end)
        end
    end

    -- Global Toggle Keybind
    if toggleKey and typeof(toggleKey) == "EnumItem" then
        local cToggle = UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == toggleKey then
                WindowObj:Toggle()
            end
        end)
        table.insert(WindowObj.Connections, cToggle)
    end

    -- Mobile Draggable Toggle Bubble Widget
    if showMobileToggle then
        local bubble = Instance.new("TextButton", ScreenGui)
        bubble.Size = UDim2.new(0, 42, 0, 42)
        bubble.Position = UDim2.new(0, 20, 0.5, -21)
        bubble.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
        bubble.BackgroundTransparency = 0.25
        bubble.Text = "⚡"
        bubble.TextColor3 = T.Accent
        bubble.Font = Enum.Font.GothamBold
        bubble.TextSize = 16
        bubble.ZIndex = 110
        bubble.AutoButtonColor = false
        Instance.new("UICorner", bubble).CornerRadius = UDim.new(1, 0)

        local bStroke = Instance.new("UIStroke", bubble)
        bStroke.Color = T.Stroke
        bStroke.Thickness = 1.5
        bStroke.Transparency = 0.4

        local bDrag, bStart, bPos = false, nil, nil
        bubble.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                bDrag = true
                bStart = input.Position
                bPos = bubble.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then bDrag = false end
                end)
            end
        end)
        bubble.InputChanged:Connect(function(input)
            if bDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - bStart
                bubble.Position = UDim2.new(bPos.X.Scale, bPos.X.Offset + delta.X, bPos.Y.Scale, bPos.Y.Offset + delta.Y)
            end
        end)
        bubble.MouseButton1Click:Connect(function()
            WindowObj:Toggle()
        end)
    end

    -- Minimize Handling
    MinBtn.MouseButton1Click:Connect(function()
        if WindowObj.IsClosing or WindowObj.IsClosed then return end
        closeActiveDropdown()
        WindowObj.IsMinimized = not WindowObj.IsMinimized
        if WindowObj.IsMinimized then
            BodyFrame.Visible = false
            TweenService:Create(MainFrame, TweenInfo.new(0.2), {
                Size = UDim2.new(winSize.X.Scale, winSize.X.Offset, 0, topbarH)
            }):Play()
            MinBtn.Text = "+"
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.2), {
                Size = winSize
            }):Play()
            task.delay(0.2, function()
                if not WindowObj.IsMinimized then BodyFrame.Visible = true end
            end)
            MinBtn.Text = "-"
        end
    end)

    function WindowObj:AddHeaderBadge(text, bgColor, textColor)
        local badge = Instance.new("TextButton", HeaderControls)
        badge.Size = UDim2.new(0, 0, 0, math.clamp(topbarH - 12, 22, 28))
        badge.AutomaticSize = Enum.AutomaticSize.X
        badge.BackgroundColor3 = bgColor or Color3.fromRGB(24, 24, 30)
        badge.BackgroundTransparency = 0.35
        badge.Text = ""
        badge.AutoButtonColor = false
        Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 6)

        local bStroke = Instance.new("UIStroke", badge)
        bStroke.Color = T.Stroke
        bStroke.Thickness = 1
        bStroke.Transparency = 0.6

        local pad = Instance.new("UIPadding", badge)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)

        local lbl = Instance.new("TextLabel", badge)
        lbl.Size = UDim2.new(0, 0, 1, 0)
        lbl.AutomaticSize = Enum.AutomaticSize.X
        lbl.BackgroundTransparency = 1
        lbl.Text = text or ""
        lbl.TextColor3 = textColor or T.Text
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 10

        local clickCb = nil
        badge.MouseButton1Click:Connect(function()
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            if clickCb then pcall(clickCb) end
        end)

        local BadgeObj = {}
        function BadgeObj:SetText(t) lbl.Text = t end
        function BadgeObj:SetColor(c) badge.BackgroundColor3 = c end
        function BadgeObj:SetTextColor(c) lbl.TextColor3 = c end
        function BadgeObj:SetVisible(v) badge.Visible = v end
        function BadgeObj:OnClick(fn) clickCb = fn end
        return BadgeObj
    end

    function WindowObj:AddHeaderButton(iconText, callback)
        local btn = Instance.new("TextButton", HeaderControls)
        btn.Size = UDim2.new(0, 24, 0, math.clamp(topbarH - 12, 22, 28))
        btn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        btn.BackgroundTransparency = 0.35
        btn.Text = iconText or "★"
        btn.TextColor3 = T.Text
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        local bStroke = Instance.new("UIStroke", btn)
        bStroke.Color = T.Stroke
        bStroke.Thickness = 1
        bStroke.Transparency = 0.6

        btn.MouseButton1Click:Connect(function()
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            local t1 = TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = T.Accent, BackgroundTransparency = 0.1})
            local t2 = TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 24, 30), BackgroundTransparency = 0.35})
            t1:Play()
            t1.Completed:Connect(function() t2:Play() end)
            if callback then pcall(callback) end
        end)

        local BtnObj = {}
        function BtnObj:SetText(t) btn.Text = t end
        function BtnObj:SetVisible(v) btn.Visible = v end
        return BtnObj
    end

    function WindowObj:OnClose(callback)
        if typeof(callback) == "function" then
            table.insert(self.CloseCallbacks, callback)
        end
    end

    function WindowObj:Close()
        if self.IsClosed or self.IsClosing then return end
        self.IsClosing = true
        self.IsClosed = true

        closeActiveDropdown()

        for _, conn in ipairs(self.Connections) do
            if conn and conn.Disconnect then
                pcall(function() conn:Disconnect() end)
            end
        end
        table.clear(self.Connections)

        for _, cb in ipairs(self.CloseCallbacks) do
            pcall(cb)
        end
        table.clear(self.CloseCallbacks)

        if ScreenGui and ScreenGui.Parent then
            ScreenGui:Destroy()
        end
        BottleLib.ActiveScreenGui = nil
        BottleLib.ActiveNotifyContainer = nil
    end

    CloseBtn.MouseButton1Click:Connect(function()
        WindowObj:Close()
    end)

    local cLibCleanup = BottleLib.CleanUpEvent.Event:Connect(function()
        WindowObj:Close()
    end)
    table.insert(WindowObj.Connections, cLibCleanup)

    local cCloseOverlay = GlobalOverlayClose.MouseButton1Click:Connect(closeActiveDropdown)
    table.insert(WindowObj.Connections, cCloseOverlay)

    function WindowObj:CreateTab(tabName)
        local tabBtn = Instance.new("TextButton", TabSidebar)
        tabBtn.Size = UDim2.new(1, 0, 0, 30)
        tabBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
        tabBtn.BackgroundTransparency = 0.4
        tabBtn.Text = tabName
        tabBtn.TextColor3 = T.SubText
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.TextSize = 11
        tabBtn.AutoButtonColor = false
        Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

        local tabContent = Instance.new("ScrollingFrame", ContentArea)
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.BackgroundTransparency = 1
        tabContent.BorderSizePixel = 0
        tabContent.ScrollBarThickness = 3
        tabContent.ScrollBarImageColor3 = T.Accent
        tabContent.Visible = false

        local cLayout = Instance.new("UIListLayout", tabContent)
        cLayout.SortOrder = Enum.SortOrder.LayoutOrder
        cLayout.Padding = UDim.new(0, 6)

        local cContentSize = cLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContent.CanvasSize = UDim2.new(0, 0, 0, cLayout.AbsoluteContentSize.Y + 10)
        end)
        table.insert(WindowObj.Connections, cContentSize)

        local TabAPI = {}
        BindUIElements(TabAPI, tabContent, T, WindowObj, ScreenGui, GlobalOverlayClose, 0)

        local function selectTab()
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            closeActiveDropdown()
            for _, t in pairs(WindowObj.Tabs) do
                t.Button.TextColor3 = T.SubText
                t.Button.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
                t.Button.BackgroundTransparency = 0.4
                t.Content.Visible = false
            end
            tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabBtn.BackgroundColor3 = T.Accent
            tabBtn.BackgroundTransparency = 0.15
            tabContent.Visible = true
            WindowObj.CurrentTab = TabAPI
        end

        tabBtn.MouseButton1Click:Connect(selectTab)

        table.insert(WindowObj.Tabs, {
            Button = tabBtn,
            Content = tabContent,
            API = TabAPI
        })

        if #WindowObj.Tabs == 1 then selectTab() end

        return TabAPI
    end

    return WindowObj
end

return BottleLib
