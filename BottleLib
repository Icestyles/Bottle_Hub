local semanticPrefixes   = {"Client", "Local", "System", "HUD", "Custom", "Core", "View", "Interface"}
local semanticCategories = {"Menu", "Overlay", "Display", "Action", "Status", "Module", "Widget", "Layout"}
local semanticComponents = {"Frame", "Container", "Holder", "Wrapper", "Group", "Canvas"}

local function generateNaturalName(suffixType)
    local p = semanticPrefixes[math.random(1, #semanticPrefixes)]
    local c = semanticCategories[math.random(1, #semanticCategories)]
    local s = suffixType or semanticComponents[math.random(1, #semanticComponents)]
    local tag = math.random(10, 99)
    return string.format("%s%s%s_%d", p, c, s, tag)
end

local function protectGui(gui)
    if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
        pcall(syn.protect_gui, gui)
    end
end

local function getGuiParent()
    local ok, res = pcall(function()
        return (typeof(gethui) == "function" and gethui()) or CoreGui
    end)
    return (ok and res) or player:WaitForChild("PlayerGui")
end

-- ============================================================================
-- [1] NOTIFY SYSTEM (OLED Toast with Hot-Pink Stroke)
-- ============================================================================
function BottleLib:Notify(msg)
    local parentGui = getGuiParent()
    local container = BottleLib.ActiveNotifyContainer

    if not container or not container.Parent then
        local targetGui = BottleLib.ActiveScreenGui
        if not targetGui or not targetGui.Parent then
            targetGui = Instance.new("ScreenGui")
            targetGui.Name = generateNaturalName("Gui")
            targetGui.ResetOnSpawn = false
            protectGui(targetGui)
            targetGui.Parent = parentGui
            BottleLib.ActiveScreenGui = targetGui
        end

        container = Instance.new("Frame", targetGui)
        container.Name = generateNaturalName("Container")
        container.Size = UDim2.new(0, 270, 1, -20)
        container.Position = UDim2.new(1, -20, 1, -20)
        container.AnchorPoint = Vector2.new(1, 1)
        container.BackgroundTransparency = 1
        container.ZIndex = 120

        local layout = Instance.new("UIListLayout", container)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.Padding = UDim.new(0, 8)

        BottleLib.ActiveNotifyContainer = container
    end

    local notif = Instance.new("Frame", container)
    notif.Size = UDim2.new(1, 0, 0, 44)
    notif.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
    notif.BackgroundTransparency = 1
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = Color3.fromHex("#e60852")
    stroke.Thickness = 1.2
    stroke.Transparency = 1

    local icon = Instance.new("TextLabel", notif)
    icon.Size = UDim2.new(0, 36, 1, 0)
    icon.BackgroundTransparency = 1
    icon.Text = "🔔"
    icon.TextSize = 16
    icon.TextTransparency = 1

    local lbl = Instance.new("TextLabel", notif)
    lbl.Size = UDim2.new(1, -44, 1, 0)
    lbl.Position = UDim2.new(0, 38, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = tostring(msg or "")
    lbl.TextColor3 = Color3.fromRGB(240, 240, 245)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.TextTransparency = 1

    TweenService:Create(notif, TweenInfo.new(0.25), {BackgroundTransparency = 0.08}):Play()
    TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0}):Play()
    TweenService:Create(icon, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
    TweenService:Create(lbl, TweenInfo.new(0.25), {TextTransparency = 0}):Play()

    task.delay(3, function()
        if notif and notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
            TweenService:Create(icon, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
            TweenService:Create(lbl, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
            task.wait(0.25)
            if notif and notif.Parent then notif:Destroy() end
        end
    end)
end

