        l.BackgroundTransparency = 1
        l.Text = label
        l.TextColor3 = T.SubText
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 11
        l.TextXAlignment = Enum.TextXAlignment.Left

        local Input = Instance.new("TextBox", frame)
        Input.Size = UDim2.new(0.55, 0, 0.72, 0)
        Input.Position = UDim2.new(0.42, 0, 0.14, 0)
        Input.BackgroundColor3 = T.ElemDark
        Input.BackgroundTransparency = 0.3
        Input.Text = ""
        Input.PlaceholderText = placeholder or ""
        Input.TextColor3 = T.Text
        Input.PlaceholderColor3 = Color3.fromRGB(110, 110, 120)
        Input.Font = Enum.Font.GothamBold
        Input.TextSize = 11
        Input.ClearTextOnFocus = false
        Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 4)

        Input.FocusLost:Connect(function()
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            local text = Input.Text
            if isNumberOnly then
                local num = tonumber(text)
                if num then
                    if callback then pcall(callback, num) end
                else
                    Input.Text = ""
                end
            else
                if callback then pcall(callback, text) end
            end
        end)

        local InputObj = {}
        function InputObj:Set(val, suppressCallback)
            local strVal = tostring(val or "")
            if Input.Text == strVal then return end
            Input.Text = strVal
            if not suppressCallback and not WindowObj.IsClosing and not WindowObj.IsClosed then
                if callback then pcall(callback, isNumberOnly and tonumber(strVal) or strVal) end
            end
        end
        function InputObj:Get()
            return isNumberOnly and tonumber(Input.Text) or Input.Text
        end
        return InputObj
    end

