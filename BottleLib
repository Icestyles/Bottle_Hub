    function APIObj:CreateActionList(config)
        config = config or {}
        local listHeight = config.Height or 170
        local placeholder = config.Placeholder or "Search..."
        local showSearch = (config.Search ~= false)

        local outerFrame = Instance.new("Frame", targetContainer)
        outerFrame.Size = UDim2.new(1, 0, 0, listHeight + (showSearch and 36 or 0))
        outerFrame.BackgroundColor3 = T.Element
        Instance.new("UICorner", outerFrame).CornerRadius = UDim.new(0, 6)

        local outerLayout = Instance.new("UIListLayout", outerFrame)
        outerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        outerLayout.Padding = UDim.new(0, 4)

        local searchBox = nil
        if showSearch then
            local searchContainer = Instance.new("Frame", outerFrame)
            searchContainer.Size = UDim2.new(1, -12, 0, 28)
            searchContainer.Position = UDim2.new(0, 6, 0, 4)
            searchContainer.BackgroundColor3 = T.ElemDark
            searchContainer.LayoutOrder = 1
            Instance.new("UICorner", searchContainer).CornerRadius = UDim.new(0, 4)

            searchBox = Instance.new("TextBox", searchContainer)
            searchBox.Size = UDim2.new(1, -12, 1, 0)
            searchBox.Position = UDim2.new(0, 8, 0, 0)
            searchBox.BackgroundTransparency = 1
            searchBox.PlaceholderText = "🔍 " .. placeholder
            searchBox.PlaceholderColor3 = T.SubText
            searchBox.TextColor3 = T.Text
            searchBox.Font = Enum.Font.GothamMedium
            searchBox.TextSize = 11
            searchBox.TextXAlignment = Enum.TextXAlignment.Left
        end

        local scrollFrame = Instance.new("ScrollingFrame", outerFrame)
        scrollFrame.Size = UDim2.new(1, -8, 1, showSearch and -38 or -8)
        scrollFrame.Position = UDim2.new(0, 4, 0, 0)
        scrollFrame.BackgroundTransparency = 1
        scrollFrame.BorderSizePixel = 0
        scrollFrame.ScrollBarThickness = 3
        scrollFrame.ScrollBarImageColor3 = T.Accent
        scrollFrame.LayoutOrder = 2

        local listLayout = Instance.new("UIListLayout", scrollFrame)
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 4)

        local items = {} -- [id] = { Frame, Data, State }

        local function refreshFilter()
            local filter = searchBox and string.lower(searchBox.Text) or ""
            local count = 0
            for id, it in pairs(items) do
                local title = string.lower(it.Data.Title or tostring(id))
                local sub = string.lower(it.Data.Subtitle or "")
                local visible = (filter == "" or string.find(title, filter, 1, true) or string.find(sub, filter, 1, true))
                it.Frame.Visible = visible
                if visible then count = count + 1 end
            end
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 36)
        end

        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(refreshFilter)
        end

        local ActionListObj = {}

        function ActionListObj:AddItem(id, itemData)
            -- itemData: { Title = "Name", Subtitle = "Dist", Checked = false, OnToggle = function(state), Buttons = { { Icon = "🚀", Tooltip = "", OnClick = function() end } } }
            if items[id] then
                self:UpdateItem(id, itemData)
                return
            end

            local row = Instance.new("Frame", scrollFrame)
            row.Size = UDim2.new(1, -4, 0, 32)
            row.BackgroundColor3 = T.ElemDark
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

            -- Checkbox / Status Dot (Toggleable Indicator)
            local toggleBtn = Instance.new("TextButton", row)
            toggleBtn.Size = UDim2.new(0, 24, 1, 0)
            toggleBtn.BackgroundTransparency = 1
            toggleBtn.Text = ""

            local dot = Instance.new("Frame", toggleBtn)
            dot.Size = UDim2.new(0, 10, 0, 10)
            dot.Position = UDim2.new(0.5, -5, 0.5, -5)
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local isChecked = itemData.Checked or false
            dot.BackgroundColor3 = isChecked and T.Accent or Color3.fromRGB(60, 60, 60)

            -- Labels
            local titleBtn = Instance.new("TextButton", row)
            titleBtn.Size = UDim2.new(0.55, -28, 1, 0)
            titleBtn.Position = UDim2.new(0, 26, 0, 0)
            titleBtn.BackgroundTransparency = 1
            titleBtn.Text = itemData.Title or tostring(id)
            titleBtn.TextColor3 = T.Text
            titleBtn.Font = Enum.Font.GothamSemibold
            titleBtn.TextSize = 11
            titleBtn.TextXAlignment = Enum.TextXAlignment.Left
            titleBtn.TextTruncate = Enum.TextTruncate.AtEnd

            local function toggle()
                isChecked = not isChecked
                TweenService:Create(dot, TweenInfo.new(0.15), {
                    BackgroundColor3 = isChecked and T.Accent or Color3.fromRGB(60, 60, 60)
                }):Play()
                if itemData.OnToggle then
                    pcall(itemData.OnToggle, isChecked, id)
                end
            end

            toggleBtn.MouseButton1Click:Connect(toggle)
            titleBtn.MouseButton1Click:Connect(toggle)

            -- Right Buttons Container
            local rightBtns = Instance.new("Frame", row)
            rightBtns.Size = UDim2.new(0.4, 0, 1, 0)
            rightBtns.Position = UDim2.new(0.6, 0, 0, 0)
            rightBtns.BackgroundTransparency = 1

            local rLayout = Instance.new("UIListLayout", rightBtns)
            rLayout.FillDirection = Enum.FillDirection.Horizontal
            rLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
            rLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            rLayout.Padding = UDim.new(0, 4)

            local pad = Instance.new("UIPadding", rightBtns)
            pad.PaddingRight = UDim.new(0, 6)

            if itemData.Buttons then
                for _, bConfig in ipairs(itemData.Buttons) do
                    local actBtn = Instance.new("TextButton", rightBtns)
                    actBtn.Size = UDim2.new(0, 24, 0, 24)
                    actBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
                    actBtn.Text = bConfig.Icon or "⚡"
                    actBtn.TextColor3 = T.Text
                    actBtn.Font = Enum.Font.GothamBold
                    actBtn.TextSize = 12
                    actBtn.AutoButtonColor = false
                    Instance.new("UICorner", actBtn).CornerRadius = UDim.new(0, 4)

                    actBtn.MouseButton1Click:Connect(function()
                        local t1 = TweenService:Create(actBtn, TweenInfo.new(0.1), {BackgroundColor3 = T.Accent})
                        local t2 = TweenService:Create(actBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 28)})
                        t1:Play()
                        t1.Completed:Connect(function() t2:Play() end)
                        if bConfig.OnClick then pcall(bConfig.OnClick, id, itemData) end
                    end)
                end
            end

            items[id] = {
                Frame = row,
                Dot = dot,
                TitleLabel = titleBtn,
                Data = itemData,
                GetChecked = function() return isChecked end,
                SetChecked = function(st)
                    isChecked = st
                    dot.BackgroundColor3 = isChecked and T.Accent or Color3.fromRGB(60, 60, 60)
                end
            }
            refreshFilter()
        end

        function ActionListObj:RemoveItem(id)
            if items[id] then
                items[id].Frame:Destroy()
                items[id] = nil
                refreshFilter()
            end
        end

        function ActionListObj:UpdateItem(id, itemData)
            if items[id] then
                items[id].Data = itemData
                items[id].TitleLabel.Text = itemData.Title or tostring(id)
                if itemData.Checked ~= nil then
                    items[id].SetChecked(itemData.Checked)
                end
                refreshFilter()
            end
        end

        function ActionListObj:Clear()
            for _, it in pairs(items) do
                it.Frame:Destroy()
            end
            table.clear(items)
            refreshFilter()
        end

        return ActionListObj
    end

    -- Custom Container Frame
    function APIObj:CreateCustomFrame(height)
        local frame = Instance.new("Frame", targetContainer)
        frame.Size = UDim2.new(1, 0, 0, height or 40)
        frame.BackgroundColor3 = T.Element
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
        return frame
    end

    function APIObj:CreateFolder(folderName)
        local isSubFolder = (_depth >= 1)
        local bgColor     = isSubFolder and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(15, 15, 15)
        local strokeColor = isSubFolder and Color3.fromRGB(28, 28, 28) or Color3.fromRGB(35, 35, 35)
        local headerH     = isSubFolder and 28 or 34
        local headerFs    = isSubFolder and 11 or 12
        local indentL     = isSubFolder and 8 or 0
        local indentR     = isSubFolder and 4 or 0

        local folderFrame = Instance.new("Frame", targetContainer)
        folderFrame.Size = UDim2.new(1, 0, 0, headerH)
        folderFrame.AutomaticSize = Enum.AutomaticSize.Y
        folderFrame.BackgroundColor3 = bgColor
        folderFrame.BorderSizePixel = 0
        Instance.new("UICorner", folderFrame).CornerRadius = UDim.new(0, 4)

        local fStroke = Instance.new("UIStroke", folderFrame)
        fStroke.Color = strokeColor
        fStroke.Thickness = 1
        if isSubFolder then fStroke.LineJoinMode = Enum.LineJoinMode.Round end

        local fLayout = Instance.new("UIListLayout", folderFrame)
        fLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local headerBtn = Instance.new("TextButton", folderFrame)
        headerBtn.Size = UDim2.new(1, 0, 0, headerH)
        headerBtn.BackgroundTransparency = 1

        if not isSubFolder then
            local accentBar = Instance.new("Frame", headerBtn)
            accentBar.Size = UDim2.new(0, 3, 1, 0)
            accentBar.Position = UDim2.new(0, 0, 0, 0)
            accentBar.BackgroundColor3 = T.Accent
            accentBar.BackgroundTransparency = 0.4
            accentBar.BorderSizePixel = 0
            accentBar.ZIndex = 2
            Instance.new("UICorner", accentBar).CornerRadius = UDim.new(0, 4)
        end

        local arrowOpen  = "  ▼  "
        local arrowClose = "  ▶  "
        headerBtn.Text = (isSubFolder and (arrowOpen .. "<font color='#888888'>" .. folderName .. "</font>") or (arrowOpen .. folderName))
        headerBtn.RichText = true
        headerBtn.TextColor3 = T.Text
        headerBtn.Font = Enum.Font.GothamBold
        headerBtn.TextSize = headerFs
        headerBtn.TextXAlignment = Enum.TextXAlignment.Left

        local headerSep = Instance.new("Frame", folderFrame)
        headerSep.Size = UDim2.new(1, 0, 0, 1)
        headerSep.BackgroundColor3 = strokeColor
        headerSep.BorderSizePixel = 0
        headerSep.Visible = true

        local innerContainer = Instance.new("Frame", folderFrame)
        innerContainer.Size = UDim2.new(1, 0, 0, 0)
        innerContainer.AutomaticSize = Enum.AutomaticSize.Y
        innerContainer.BackgroundTransparency = 1
        innerContainer.ClipsDescendants = true

        local innerLayout = Instance.new("UIListLayout", innerContainer)
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Padding = UDim.new(0, isSubFolder and 4 or 6)

        local innerPad = Instance.new("UIPadding", innerContainer)
        innerPad.PaddingTop = UDim.new(0, isSubFolder and 4 or 6)
        innerPad.PaddingBottom = UDim.new(0, isSubFolder and 5 or 8)
        innerPad.PaddingLeft = UDim.new(0, (isSubFolder and 6 or 10) + indentL)
        innerPad.PaddingRight = UDim.new(0, (isSubFolder and 4 or 10) + indentR)

        local isOpen = true
        headerBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            innerContainer.Visible = isOpen
            headerSep.Visible = isOpen
            local arrow = isOpen and arrowOpen or arrowClose
            headerBtn.Text = (isSubFolder and (arrow .. "<font color='#888888'>" .. folderName .. "</font>") or (arrow .. folderName))
        end)

        local FolderObj = {}
        BindUIElements(FolderObj, innerContainer, T, WindowObj, ScreenGui, GlobalOverlayClose, _depth + 1)
        return FolderObj
    end
end

-- ============================================================================
-- [3] WINDOW & HEADER CONTROLS BUILDER
-- ============================================================================
function BottleLib:CreateWindow(WindowConfig)
    BottleLib.CleanUpEvent:Fire()

    WindowConfig = WindowConfig or {}
    local titleText = WindowConfig.Title or "BottleLib UI"
    local winSize = WindowConfig.Size or UDim2.new(0, 580, 0, 390)

    local T = {
        Accent   = WindowConfig.Accent or Color3.fromHex("#e60852"),
        Element  = Color3.fromRGB(24, 24, 24),
        ElemDark = Color3.fromRGB(16, 16, 16),
        Text     = Color3.fromRGB(245, 245, 245),
        SubText  = Color3.fromRGB(150, 150, 150)
    }

    local parentGui = getGuiParent()
    local oldGui = parentGui:FindFirstChild("BOTTLEHUB_MAIN")
    if oldGui then oldGui:Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "BOTTLEHUB_MAIN"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = parentGui

    local GlobalOverlayClose = Instance.new("TextButton", ScreenGui)
    GlobalOverlayClose.Size = UDim2.new(1, 0, 1, 0)
    GlobalOverlayClose.BackgroundTransparency = 1
    GlobalOverlayClose.Text = ""
    GlobalOverlayClose.Visible = false
    GlobalOverlayClose.ZIndex = 70

    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Name = "MainFrame"
    MainFrame.Size = winSize
    MainFrame.Position = UDim2.new(0.5, -winSize.X.Offset / 2, 0.5, -winSize.Y.Offset / 2)
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

    local mainStroke = Instance.new("UIStroke", MainFrame)
    mainStroke.Color = Color3.fromRGB(35, 35, 35)
    mainStroke.Thickness = 1

    -- Topbar
    local Topbar = Instance.new("Frame", MainFrame)
    Topbar.Size = UDim2.new(1, 0, 0, 36)
    Topbar.BackgroundTransparency = 1

    local TitleLbl = Instance.new("TextLabel", Topbar)
    TitleLbl.Size = UDim2.new(0, 160, 1, 0)
    TitleLbl.Position = UDim2.new(0, 12, 0, 0)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = titleText
    TitleLbl.TextColor3 = T.Text
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 13
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

    -- Header Controls Container (Badges + Header Buttons)
    local HeaderControls = Instance.new("Frame", Topbar)
    HeaderControls.Size = UDim2.new(1, -240, 1, 0)
    HeaderControls.Position = UDim2.new(0, 175, 0, 0)
    HeaderControls.BackgroundTransparency = 1

    local hLayout = Instance.new("UIListLayout", HeaderControls)
    hLayout.FillDirection = Enum.FillDirection.Horizontal
    hLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    hLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    hLayout.Padding = UDim.new(0, 6)

    -- Window Controls (Minimize & Close)
    local WinControls = Instance.new("Frame", Topbar)
    WinControls.Size = UDim2.new(0, 60, 1, 0)
    WinControls.Position = UDim2.new(1, -66, 0, 0)
    WinControls.BackgroundTransparency = 1

    local wLayout = Instance.new("UIListLayout", WinControls)
    wLayout.FillDirection = Enum.FillDirection.Horizontal
    wLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    wLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    wLayout.Padding = UDim.new(0, 6)

    local MinBtn = Instance.new("TextButton", WinControls)
    MinBtn.Size = UDim2.new(0, 24, 0, 24)
    MinBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    MinBtn.Text = "–"
    MinBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.TextSize = 12
    MinBtn.AutoButtonColor = false
    Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(0, 4)

    local CloseBtn = Instance.new("TextButton", WinControls)
    CloseBtn.Size = UDim2.new(0, 24, 0, 24)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    CloseBtn.Text = "✕"
    CloseBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 10
    CloseBtn.AutoButtonColor = false
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)

    -- Window Dragging
    local dragging, dragStart, startPos = false, nil, nil
    Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Topbar.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Body
    local BodyFrame = Instance.new("Frame", MainFrame)
    BodyFrame.Size = UDim2.new(1, -20, 1, -48)
    BodyFrame.Position = UDim2.new(0, 10, 0, 38)
    BodyFrame.BackgroundTransparency = 1

    local TabSidebar = Instance.new("ScrollingFrame", BodyFrame)
    TabSidebar.Size = UDim2.new(0, 130, 1, 0)
    TabSidebar.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
    TabSidebar.BorderSizePixel = 0
    TabSidebar.ScrollBarThickness = 2
    Instance.new("UICorner", TabSidebar).CornerRadius = UDim.new(0, 6)

    local tabLayout = Instance.new("UIListLayout", TabSidebar)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Padding = UDim.new(0, 4)
    local tabPad = Instance.new("UIPadding", TabSidebar)
    tabPad.PaddingTop = UDim.new(0, 6)
    tabPad.PaddingLeft = UDim.new(0, 6)
    tabPad.PaddingRight = UDim.new(0, 6)

    local ContentArea = Instance.new("Frame", BodyFrame)
    ContentArea.Size = UDim2.new(1, -140, 1, 0)
    ContentArea.Position = UDim2.new(0, 140, 0, 0)
    ContentArea.BackgroundTransparency = 1

    -- Object Interface
    local WindowObj = {
        ActiveDropdown = nil,
        Tabs = {},
        CurrentTab = nil,
        CloseCallbacks = {},
        IsClosed = false,
        IsMinimized = false
    }

    -- Minimize Handling
    MinBtn.MouseButton1Click:Connect(function()
        WindowObj.IsMinimized = not WindowObj.IsMinimized
        if WindowObj.IsMinimized then
            BodyFrame.Visible = false
            TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(winSize.X.Scale, winSize.X.Offset, 0, 36)}):Play()
            MinBtn.Text = "+"
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = winSize}):Play()
            task.delay(0.2, function()
                if not WindowObj.IsMinimized then BodyFrame.Visible = true end
            end)
            MinBtn.Text = "–"
        end
    end)

    -- [FEATURE 1] ON-CLOSE & FULL CLEANUP HANDLING
    function WindowObj:OnClose(callback)
        if typeof(callback) == "function" then
            table.insert(self.CloseCallbacks, callback)
        end
    end

    function WindowObj:Close()
        if self.IsClosed then return end
        self.IsClosed = true

        -- ทำการรัน Full Cleanup Callbacks ทั้งหมดที่สคริปต์ลงทะเบียนไว้
        for _, cb in ipairs(self.CloseCallbacks) do
            pcall(cb)
        end

        if ScreenGui and ScreenGui.Parent then
            ScreenGui:Destroy()
        end
    end

    CloseBtn.MouseButton1Click:Connect(function()
        WindowObj:Close()
    end)

    BottleLib.CleanUpEvent.Event:Connect(function()
        WindowObj:Close()
    end)

    -- [FEATURE 3] TOPBAR HEADER CONTROLS (Badges & Buttons)
    function WindowObj:AddHeaderBadge(text, bgColor)
        local badge = Instance.new("Frame", HeaderControls)
        badge.Size = UDim2.new(0, 0, 0, 22)
        badge.AutomaticSize = Enum.AutomaticSize.X
        badge.BackgroundColor3 = bgColor or Color3.fromRGB(24, 24, 24)
        Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 4)

        local pad = Instance.new("UIPadding", badge)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)

        local lbl = Instance.new("TextLabel", badge)
        lbl.Size = UDim2.new(0, 0, 1, 0)
        lbl.AutomaticSize = Enum.AutomaticSize.X
        lbl.BackgroundTransparency = 1
        lbl.Text = text or ""
        lbl.TextColor3 = T.Text
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 10

        local BadgeObj = {}
        function BadgeObj:SetText(t) lbl.Text = t end
        function BadgeObj:SetColor(c) badge.BackgroundColor3 = c end
        function BadgeObj:SetVisible(v) badge.Visible = v end
        return BadgeObj
    end

    function WindowObj:AddHeaderButton(iconText, callback)
        local btn = Instance.new("TextButton", HeaderControls)
        btn.Size = UDim2.new(0, 24, 0, 22)
        btn.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
        btn.Text = iconText or "★"
        btn.TextColor3 = T.Text
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            local t1 = TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = T.Accent})
            local t2 = TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 24, 24)})
            t1:Play()
            t1.Completed:Connect(function() t2:Play() end)
            if callback then pcall(callback) end
        end)

        local BtnObj = {}
        function BtnObj:SetText(t) btn.Text = t end
        function BtnObj:SetVisible(v) btn.Visible = v end
        return BtnObj
    end

    GlobalOverlayClose.MouseButton1Click:Connect(function()
        if WindowObj.ActiveDropdown then
            WindowObj.ActiveDropdown.Visible = false
            WindowObj.ActiveDropdown = nil
        end
        GlobalOverlayClose.Visible = false
    end)

    function WindowObj:CreateTab(tabName)
        local tabBtn = Instance.new("TextButton", TabSidebar)
        tabBtn.Size = UDim2.new(1, 0, 0, 30)
        tabBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        tabBtn.Text = tabName
        tabBtn.TextColor3 = T.SubText
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.TextSize = 11
        tabBtn.AutoButtonColor = false
        Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 4)

        local tabContent = Instance.new("ScrollingFrame", ContentArea)
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.BackgroundTransparency = 1
        tabContent.BorderSizePixel = 0
        tabContent.ScrollBarThickness = 3
        tabContent.ScrollBarImageColor3 = T.Accent
        tabContent.Visible = false

        local cLayout = Instance.new("UIListLayout", tabContent)
        cLayout.SortOrder = Enum.SortOrder.LayoutOrder
        cLayout.Padding = UDim.new(0, 6)

        cLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContent.CanvasSize = UDim2.new(0, 0, 0, cLayout.AbsoluteContentSize.Y + 10)
        end)

        local TabAPI = {}
        BindUIElements(TabAPI, tabContent, T, WindowObj, ScreenGui, GlobalOverlayClose, 0)

        local function selectTab()
            for _, t in pairs(WindowObj.Tabs) do
                t.Button.TextColor3 = T.SubText
                t.Button.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                t.Content.Visible = false
            end
            tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabBtn.BackgroundColor3 = T.Accent
            tabContent.Visible = true
            WindowObj.CurrentTab = TabAPI
        end

        tabBtn.MouseButton1Click:Connect(selectTab)

        table.insert(WindowObj.Tabs, {
            Button = tabBtn,
            Content = tabContent,
            API = TabAPI
        })

        if #WindowObj.Tabs == 1 then selectTab() end

        return TabAPI
    end

    return WindowObj
end

return BottleLib
