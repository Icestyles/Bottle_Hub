    function WindowObj:Track(item)
        if not item then return item end
        for _, existing in ipairs(self.TrackedResources) do
            if existing == item then
                return item
            end
        end
        table.insert(self.TrackedResources, item)
        return item
    end
    WindowObj.AddCleanup = WindowObj.Track

    function WindowObj:Untrack(item)
        for i = #self.TrackedResources, 1, -1 do
            if self.TrackedResources[i] == item then
                table.remove(self.TrackedResources, i)
                break
            end
        end
        return item
    end
    WindowObj.RemoveCleanup = WindowObj.Untrack

    function WindowObj:OnClose(callback)
        if typeof(callback) == "function" then
            table.insert(self.CloseCallbacks, callback)
        end
    end

    function WindowObj:Close()
        if self.IsClosed or self.IsClosing then return end
        self.IsClosing = true
        self.IsClosed = true

        closeActiveDropdown()

        -- 1. Disconnect all internal UI connections
        for _, conn in ipairs(self.Connections) do
            if conn and conn.Disconnect then
                pcall(function() conn:Disconnect() end)
            end
        end
        table.clear(self.Connections)

        -- 2. Clean up all tracked external resources (Drawings, Connections, Threads, Instances, Callbacks)
        for i = #self.TrackedResources, 1, -1 do
            local res = self.TrackedResources[i]
            if res then
                pcall(function()
                    cleanResource(res)
                end)
            end
        end
        table.clear(self.TrackedResources)

        -- 3. Run all user OnClose callbacks
        for _, cb in ipairs(self.CloseCallbacks) do
            pcall(cb)
        end
        table.clear(self.CloseCallbacks)

        -- 4. Destroy MiniDock
        if MiniDock and MiniDock.Parent then
            MiniDock:Destroy()
        end

        -- 5. Destroy ScreenGui
        if ScreenGui and ScreenGui.Parent then
            ScreenGui:Destroy()
        end

        if BottleLib.ActiveWindow == self then
            BottleLib.ActiveWindow = nil
        end
        BottleLib.ActiveScreenGui = nil
        BottleLib.ActiveNotifyContainer = nil

        -- 6. Trigger global library cleanup
        pcall(function()
            BottleLib.CleanUpEvent:Fire()
        end)
    end

