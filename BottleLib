    function APIObj:CreateDropdown(placeholder, optionsList, multiSelect, callback)
        local frame = Instance.new("Frame", targetContainer)
        frame.Size = UDim2.new(1, 0, 0, 34)
        frame.BackgroundColor3 = T.Element
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

        local Input = Instance.new("TextBox", frame)
        Input.Size = UDim2.new(1, -20, 1, 0)
        Input.Position = UDim2.new(0, 10, 0, 0)
        Input.BackgroundTransparency = 1
        Input.Text = ""
        Input.PlaceholderText = "🔍 " .. placeholder
        Input.TextColor3 = T.Text
        Input.PlaceholderColor3 = T.SubText
        Input.Font = Enum.Font.GothamSemibold
        Input.TextSize = 11
        Input.TextXAlignment = Enum.TextXAlignment.Left

        local DropOverlay = Instance.new("Frame", ScreenGui)
        DropOverlay.Size = UDim2.new(0, 220, 0, 160)
        DropOverlay.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
        DropOverlay.Visible = false
        DropOverlay.ZIndex = 80
        Instance.new("UICorner", DropOverlay).CornerRadius = UDim.new(0, 6)
        Instance.new("UIStroke", DropOverlay).Color = T.Accent

        local DScroll = Instance.new("ScrollingFrame", DropOverlay)
        DScroll.Size = UDim2.new(1, -4, 1, -4)
        DScroll.Position = UDim2.new(0, 2, 0, 2)
        DScroll.BackgroundTransparency = 1
        DScroll.ScrollBarThickness = 3
        DScroll.ScrollBarImageColor3 = T.Accent
        DScroll.BorderSizePixel = 0
        DScroll.ZIndex = 81
        Instance.new("UIListLayout", DScroll).SortOrder = Enum.SortOrder.LayoutOrder

        local selectedFromList = false
        local selectedItems = {}

        local function getSelectedArray()
            local arr = {}
            for k, v in pairs(selectedItems) do if v then table.insert(arr, k) end end
            return arr
        end

        local function RefreshList(filterText)
            for _, c in ipairs(DScroll:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            local count = 0
            local ft = string.lower(filterText or "")
            for _, item in ipairs(optionsList) do
                if ft == "" or string.find(string.lower(item), ft, 1, true) then
                    count = count + 1
                    local b = Instance.new("TextButton", DScroll)
                    b.Size = UDim2.new(1, 0, 0, 30)
                    b.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                    b.Text = "  " .. item
                    b.TextColor3 = T.Text
                    b.Font = Enum.Font.GothamMedium
                    b.TextSize = 11
                    b.TextXAlignment = Enum.TextXAlignment.Left
                    b.ZIndex = 82

                    if multiSelect and selectedItems[item] then
                        b.TextColor3 = T.Accent
                        b.Text = "  ✅ " .. item
                    end

                    b.MouseButton1Click:Connect(function()
                        if multiSelect then
                            selectedFromList = true
                            selectedItems[item] = not selectedItems[item]
                            if selectedItems[item] then
                                b.TextColor3 = T.Accent
                                b.Text = "  ✅ " .. item
                            else
                                b.TextColor3 = T.Text
                                b.Text = "  " .. item
                            end
                            local sArr = getSelectedArray()
                            if #sArr == 0 then
                                Input.Text = ""
                            elseif #sArr == 1 then
                                Input.Text = sArr[1]
                            else
                                Input.Text = #sArr .. " Items Selected"
                            end
                            if callback then pcall(callback, sArr) end
                        else
                            selectedFromList = true
                            Input.Text = item
                            if callback then pcall(callback, item) end
                            DropOverlay.Visible = false
                            WindowObj.ActiveDropdown = nil
                            GlobalOverlayClose.Visible = false
                        end
                    end)
                end
            end
            DScroll.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 4)
        end

        local DropObj = {}
        function DropObj:Refresh(newList)
            optionsList = newList
            table.clear(selectedItems)
            if multiSelect then Input.Text = "" end
            RefreshList(Input.Text)
        end

        function DropObj:Set(items)
            table.clear(selectedItems)
            if multiSelect and type(items) == "table" then
                for _, v in ipairs(items) do selectedItems[v] = true end
                Input.Text = #items .. " Items Selected"
            elseif type(items) == "string" then
                if multiSelect then selectedItems[items] = true end
                Input.Text = items
            end
            RefreshList("")
        end

        Input.Focused:Connect(function()
            if WindowObj.ActiveDropdown and WindowObj.ActiveDropdown ~= DropOverlay then
                WindowObj.ActiveDropdown.Visible = false
            end
            WindowObj.ActiveDropdown = DropOverlay
            local pos = frame.AbsolutePosition
            local sz = frame.AbsoluteSize
            local yPos = pos.Y + sz.Y + 4
            if yPos + 160 > ScreenGui.AbsoluteSize.Y then
                yPos = pos.Y - 164
            end
            DropOverlay.Position = UDim2.new(0, pos.X, 0, yPos)
            DropOverlay.Size = UDim2.new(0, math.max(sz.X, 220), 0, 160)
            RefreshList(Input.Text)
            DropOverlay.Visible = true
            GlobalOverlayClose.Visible = true
        end)

        Input:GetPropertyChangedSignal("Text"):Connect(function()
            if DropOverlay.Visible and not selectedFromList then
                RefreshList(Input.Text)
            end
        end)

        Input.FocusLost:Connect(function()
            if selectedFromList then selectedFromList = false; return end
            if not multiSelect and Input.Text ~= "" and callback then
                pcall(callback, Input.Text)
            end
        end)

        return DropObj
    end

