            ToggleObj:Set(not state, false)
        end)

        return ToggleObj
    end

    function APIObj:CreateSlider(label, min, max, default, stepOrCallback, callback)
        local step = 1
        local cb = callback
        if typeof(stepOrCallback) == "function" then
            cb = stepOrCallback
            step = 1
        elseif typeof(stepOrCallback) == "number" then
            step = stepOrCallback
        end

        local frame = Instance.new("Frame", targetContainer)
        frame.Size = UDim2.new(1, 0, 0, 34)
        frame.BackgroundColor3 = T.Element
        frame.BackgroundTransparency = 0.35
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = T.Stroke
        stroke.Thickness = 1
        stroke.Transparency = 0.4

        local lbl = Instance.new("TextLabel", frame)
        lbl.Size = UDim2.new(0.5, -12, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = T.Text
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextTruncate = Enum.TextTruncate.AtEnd

        local track = Instance.new("Frame", frame)
        track.Size = UDim2.new(0.45, 0, 0, 5)
        track.Position = UDim2.new(0.52, 0, 0.5, -2)
        track.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        track.BorderSizePixel = 0
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0)
        fill.BackgroundColor3 = T.Accent
        fill.BorderSizePixel = 0
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local trackHit = Instance.new("TextButton", frame)
        trackHit.Size = UDim2.new(0.45, 0, 1, 0)
        trackHit.Position = UDim2.new(0.52, 0, 0, 0)
        trackHit.BackgroundTransparency = 1
        trackHit.Text = ""
        trackHit.ZIndex = 3
        trackHit.AutoButtonColor = false

        local function formatValue(val, st)
            if st < 1 then
                local stStr = tostring(st)
                local dec = 1
                local dot = string.find(stStr, "%.")
                if dot then dec = #stStr - dot end
                return string.format("%." .. dec .. "f", val)
            else
                return tostring(math.floor(val + 0.5))
            end
        end

        local function snapToStep(val, st)
            if not st or st <= 0 then return val end
            return math.floor((val / st) + 0.5) * st
        end

        local currentValue = math.clamp(snapToStep(default, step), min, max)

        local function update(v, suppressCallback)
            currentValue = math.clamp(snapToStep(v, step), min, max)
            local res = nil
            if not suppressCallback and not WindowObj.IsClosing and not WindowObj.IsClosed then
                if cb then _, res = pcall(cb, currentValue) end
            end
            lbl.Text = label .. ": " .. (res or formatValue(currentValue, step))
        end
        update(default, true)

        local dragging = false
        local startX = 0
        local startRatio = math.clamp((default - min) / (max - min), 0, 1)
        local trackWidth = 1

        local cDown = trackHit.MouseButton1Down:Connect(function(x)
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            dragging = true
            startX = x
            startRatio = fill.Size.X.Scale
            trackWidth = math.max(trackHit.AbsoluteSize.X, 1)
        end)
        table.insert(WindowObj.Connections, cDown)

        local cMove = UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local dx = input.Position.X - startX
                local newRatio = math.clamp(startRatio + dx / trackWidth, 0, 1)
                fill.Size = UDim2.new(newRatio, 0, 1, 0)
                local rawVal = min + (max - min) * newRatio
                update(rawVal, false)
            end
        end)
        table.insert(WindowObj.Connections, cMove)

        local cEnd = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        table.insert(WindowObj.Connections, cEnd)

        local SliderObj = {}
        function SliderObj:Set(val, suppressCallback)
            val = math.clamp(snapToStep(val, step), min, max)
            if currentValue == val then return end
            local ratio = math.clamp((val - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            update(val, suppressCallback)
        end
        function SliderObj:Get() return currentValue end
        return SliderObj
    end

