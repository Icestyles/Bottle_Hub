            tabBtn.BackgroundTransparency = 0.1
            tabContent.Visible = true
            WindowObj.CurrentTab = TabAPI

            task.defer(function()
                if tabContent and tabContent.Parent then
                    tabContent.CanvasPosition = Vector2.new(0, 0)
                end
            end)
        end

        tabBtn.MouseButton1Click:Connect(selectTab)

        table.insert(WindowObj.Tabs, {
            Button = tabBtn,
            Content = tabContent,
            API = TabAPI,
            IsConfigTab = isConfigTab
        })

        if not isConfigTab and WindowObj.CurrentTab == nil then
            selectTab()
        elseif #WindowObj.Tabs == 1 and not isConfigTab then
            selectTab()
        end

        return TabAPI
    end

    -- =========================================================================
    -- CONFIGURATION ENGINE (Multi-Account UserId Isolation & Element Presets)
    -- =========================================================================
    BottleLib._InMemoryConfigs = BottleLib._InMemoryConfigs or {}

    local function getConfigFolder(rootName)
        local root = rootName or configFolder
        local pId = tostring(game.PlaceId)
        local uId = tostring(player.UserId)
        local path = string.format("%s/Configs/%s/%s/", root, pId, uId)

        pcall(function()
            if typeof(makefolder) == "function" then
                if typeof(isfolder) == "function" then
                    if not isfolder(root) then makefolder(root) end
                    if not isfolder(root .. "/Configs") then makefolder(root .. "/Configs") end
                    if not isfolder(root .. "/Configs/" .. pId) then makefolder(root .. "/Configs/" .. pId) end
                    if not isfolder(path) then makefolder(path) end
                else
                    makefolder(root)
                    makefolder(root .. "/Configs")
                    makefolder(root .. "/Configs/" .. pId)
                    makefolder(path)
                end
            end
        end)
        return path
    end

    local function getMemKey(cfgName)
        return string.format("%s_%s_%s", tostring(game.PlaceId), tostring(player.UserId), tostring(cfgName))
    end

    function WindowObj:SaveConfig(configName)
        configName = tostring(configName or "default"):gsub("[^%w_%-]", "")
        if configName == "" then configName = "default" end

        local payload = {
            _Version = BottleLib.Version,
            _PlaceId = game.PlaceId,
            _UserId = player.UserId,
            _Timestamp = os.time(),
            ServerHop = {
                Mode = WindowConfig.ServerHopMode or "Nearest",
                BlacklistDuration = WindowConfig.ServerHopBlacklistDuration or 600,
                MaxPages = WindowConfig.ServerHopMaxPages or 3,
                MaxPing = WindowConfig.ServerHopMaxPing or 130
            },
            Elements = {}
        }

        for name, item in pairs(self.ConfigRegistry) do
            local ok, val = pcall(function() return item.Get() end)
            if ok and val ~= nil then
                payload.Elements[name] = val
            end
        end

        local jsonStr = HttpService:JSONEncode(payload)
        local path = getConfigFolder(configFolder) .. configName .. ".json"

        local saved = false
        if typeof(writefile) == "function" then
            local ok = pcall(function() writefile(path, jsonStr) end)
            if ok then saved = true end
        end

        if not saved then
            BottleLib._InMemoryConfigs[getMemKey(configName)] = jsonStr
            saved = true
        end

        BottleLib:Notify("Config '" .. configName .. "' saved successfully!")
        return true
    end

    function WindowObj:LoadConfig(configName, suppressCallbacks)
        configName = tostring(configName or "default"):gsub("[^%w_%-]", "")
        if configName == "" then configName = "default" end

        local path = getConfigFolder(configFolder) .. configName .. ".json"
        local jsonStr = nil

        if typeof(readfile) == "function" and typeof(isfile) == "function" and isfile(path) then
            local ok, content = pcall(readfile, path)
            if ok and typeof(content) == "string" then jsonStr = content end
        elseif typeof(readfile) == "function" then
            local ok, content = pcall(readfile, path)
            if ok and typeof(content) == "string" then jsonStr = content end
        end

        if not jsonStr then
            jsonStr = BottleLib._InMemoryConfigs[getMemKey(configName)]
        end

        if not jsonStr then
            BottleLib:Notify("Config '" .. configName .. "' not found!")
            return false
        end

        local okDecode, decoded = pcall(function() return HttpService:JSONDecode(jsonStr) end)
        if not okDecode or type(decoded) ~= "table" then
            BottleLib:Notify("Failed to decode config JSON!")
            return false
        end

        -- 1. Restore ServerHop settings if present
        if type(decoded.ServerHop) == "table" then
            if decoded.ServerHop.Mode then
                WindowConfig.ServerHopMode = decoded.ServerHop.Mode
                if self._HopModeDropdown then
                    local m = tostring(decoded.ServerHop.Mode or ""):lower()
                    local lbl = "Nearest"
                    if string.find(m, "lowest") then lbl = "Lowest"
                    elseif string.find(m, "highest") then lbl = "Highest"
                    elseif string.find(m, "random") then lbl = "Random"
                    end
                    pcall(function() self._HopModeDropdown:Set(lbl, true) end)
                end
            end
            if decoded.ServerHop.BlacklistDuration then
                WindowConfig.ServerHopBlacklistDuration = decoded.ServerHop.BlacklistDuration
                if self._HopDurationSlider then pcall(function() self._HopDurationSlider:Set(math.floor(decoded.ServerHop.BlacklistDuration / 60), true) end) end
            end
            if decoded.ServerHop.MaxPages then
                WindowConfig.ServerHopMaxPages = decoded.ServerHop.MaxPages
                if self._HopPagesSlider then pcall(function() self._HopPagesSlider:Set(decoded.ServerHop.MaxPages, true) end) end
            end
            if decoded.ServerHop.MaxPing then
                WindowConfig.ServerHopMaxPing = decoded.ServerHop.MaxPing
                if self._HopPingSlider then pcall(function() self._HopPingSlider:Set(decoded.ServerHop.MaxPing, true) end) end
            end
        end

        -- 2. Restore Elements
        local restoredCount = 0
        if type(decoded.Elements) == "table" then
            for name, val in pairs(decoded.Elements) do
                local reg = self.ConfigRegistry[name]
                if reg and typeof(reg.Set) == "function" then
                    pcall(function()
                        reg.Set(val, suppressCallbacks or false)
                        restoredCount = restoredCount + 1
                    end)
                end
            end
        end

        BottleLib:Notify(string.format("Config '%s' loaded (%d items restored)!", configName, restoredCount))
        return true
    end

    function WindowObj:DeleteConfig(configName)
        configName = tostring(configName or ""):gsub("[^%w_%-]", "")
        if configName == "" then return false end

        local path = getConfigFolder(configFolder) .. configName .. ".json"
        local deleted = false
        if typeof(delfile) == "function" then
            pcall(function() delfile(path); deleted = true end)
        end
        if BottleLib._InMemoryConfigs[getMemKey(configName)] then
            BottleLib._InMemoryConfigs[getMemKey(configName)] = nil
            deleted = true
        end

        if deleted then
            BottleLib:Notify("Config '" .. configName .. "' deleted.")
        else
            BottleLib:Notify("Config '" .. configName .. "' could not be deleted.")
        end
        return deleted
    end

    function WindowObj:GetConfigList()
        local list = {}
        local path = getConfigFolder(configFolder)
        if typeof(listfiles) == "function" and typeof(isfolder) == "function" and isfolder(path) then
            local ok, files = pcall(listfiles, path)
            if ok and type(files) == "table" then
                for _, f in ipairs(files) do
                    local name = f:match("([^/\\]+)%.json$")
                    if name and name ~= "_autoload" then
                        table.insert(list, name)
                    end
                end
            end
        end

        local prefix = string.format("%s_%s_", tostring(game.PlaceId), tostring(player.UserId))
        for k, _ in pairs(BottleLib._InMemoryConfigs or {}) do
            if k:sub(1, #prefix) == prefix then
                local name = k:sub(#prefix + 1)
                if name ~= "_autoload" and not table.find(list, name) then
                    table.insert(list, name)
                end
            end
        end

        table.sort(list)
        return list
    end

    function WindowObj:SetAutoLoad(configName, enabled)
        local path = getConfigFolder(configFolder) .. "_autoload.json"
        local payload = {
            Enabled = enabled and true or false,
            Config = configName or "default"
        }
        local str = HttpService:JSONEncode(payload)
        if typeof(writefile) == "function" then
            pcall(function() writefile(path, str) end)
        end
        BottleLib._InMemoryConfigs[getMemKey("_autoload")] = str
    end

    function WindowObj:GetAutoLoad()
        local path = getConfigFolder(configFolder) .. "_autoload.json"
        local content = nil
        if typeof(readfile) == "function" and typeof(isfile) == "function" and isfile(path) then
            local ok, res = pcall(readfile, path)
            if ok then content = res end
        end
        if not content then
            content = BottleLib._InMemoryConfigs[getMemKey("_autoload")]
        end
        if content then
            local ok, dec = pcall(function() return HttpService:JSONDecode(content) end)
            if ok and type(dec) == "table" then
                return dec.Enabled == true, dec.Config or "default"
            end
        end
        return false, "default"
    end

    function WindowObj:BuildConfigTab()
        if self._HasBuiltConfigTab or self.IsClosed then return end
        self._HasBuiltConfigTab = true
        self._IsBuildingConfigTab = true

        local tabTitle = configTabTitle or "Configs"
        local ConfigTab = self:CreateTab("⚙️ " .. tabTitle, true)

        -- 1. Profiles Section
        ConfigTab:CreateSection("Profiles")

        local cfgNameInput = "default"
        ConfigTab:CreateInput("Profile Name", "default", false, function(txt)
            cfgNameInput = txt
        end)

        local existingList = self:GetConfigList()
        if #existingList == 0 then existingList = {"default"} end
        local selectedConfig = existingList[1] or "default"

        local configDropdown = ConfigTab:CreateDropdown("Select Profile", existingList, false, function(sel)
            selectedConfig = sel
        end)
        configDropdown:Set(selectedConfig, true)

        ConfigTab:CreateButton("Save Profile", function()
            local target = (cfgNameInput and #cfgNameInput > 0) and cfgNameInput or selectedConfig
            if self:SaveConfig(target) then
                local refreshed = self:GetConfigList()
                configDropdown:Refresh(refreshed)
                configDropdown:Set(target, true)
                selectedConfig = target
            end
        end)

        ConfigTab:CreateButton("Load Profile", function()
            self:LoadConfig(selectedConfig)
        end)

        ConfigTab:CreateButton("Delete Profile", function()
            if selectedConfig == "" or selectedConfig == "default" then
                BottleLib:Notify("Cannot delete 'default' profile or empty selection.")
                return
            end
            if self:DeleteConfig(selectedConfig) then
                local refreshed = self:GetConfigList()
                if #refreshed == 0 then refreshed = {"default"} end
                configDropdown:Refresh(refreshed)
                selectedConfig = refreshed[1] or "default"
                configDropdown:Set(selectedConfig, true)
            end
        end)

        local autoLoadEnabled, autoLoadTarget = self:GetAutoLoad()
        ConfigTab:CreateToggle("Auto Load", autoLoadEnabled, function(state)
            self:SetAutoLoad(selectedConfig or "default", state)
            BottleLib:Notify("Auto-load " .. (state and "ENABLED for '" .. tostring(selectedConfig) .. "'" or "DISABLED"))
        end)

        ConfigTab:CreateButton("Refresh List", function()
            local refreshed = self:GetConfigList()
            if #refreshed == 0 then refreshed = {"default"} end
            configDropdown:Refresh(refreshed)
            selectedConfig = refreshed[1] or "default"
            configDropdown:Set(selectedConfig, true)
            BottleLib:Notify(string.format("Found %d saved profile(s)", #refreshed))
        end)

        ConfigTab:CreateSeparator()

        -- 2. Server Hop Section
        ConfigTab:CreateSection("Server Hop")

        local hopModeOptions = {"Nearest", "Lowest", "Highest", "Random"}
        local function getModeLabel(m)
            m = tostring(m or ""):lower()
            if string.find(m, "lowest") then return "Lowest"
            elseif string.find(m, "highest") then return "Highest"
            elseif string.find(m, "random") then return "Random"
            else return "Nearest" end
        end
        local function getModeKey(label)
            label = tostring(label or ""):lower()
            if string.find(label, "lowest") then return "LowestPlayer"
            elseif string.find(label, "highest") then return "HighestPlayer"
            elseif string.find(label, "random") then return "Random"
            else return "Nearest" end
        end

        local hopMode = WindowConfig.ServerHopMode or "Nearest"
        self._HopModeDropdown = ConfigTab:CreateDropdown("Mode", hopModeOptions, false, function(sel)
            WindowConfig.ServerHopMode = getModeKey(sel)
            BottleLib:Notify("ServerHop Mode set to: " .. WindowConfig.ServerHopMode)
        end)
        self._HopModeDropdown:Set(getModeLabel(hopMode), true)

        local currentMaxPing = WindowConfig.ServerHopMaxPing or 130
        self._HopPingSlider = ConfigTab:CreateSlider("Max Ping", 50, 250, currentMaxPing, 5, function(val)
            WindowConfig.ServerHopMaxPing = val
        end)

        local currentMins = math.floor((WindowConfig.ServerHopBlacklistDuration or 600) / 60)
        self._HopDurationSlider = ConfigTab:CreateSlider("Blacklist", 1, 30, currentMins, 1, function(val)
            WindowConfig.ServerHopBlacklistDuration = val * 60
        end)

        local currentPages = WindowConfig.ServerHopMaxPages or 3
        self._HopPagesSlider = ConfigTab:CreateSlider("Pages", 1, 5, currentPages, 1, function(val)
            WindowConfig.ServerHopMaxPages = val
        end)

        ConfigTab:CreateButton("Hop Server", function()
            BottleLib:ServerHop({
                Mode = WindowConfig.ServerHopMode,
                BlacklistDuration = WindowConfig.ServerHopBlacklistDuration,
                MaxPages = WindowConfig.ServerHopMaxPages,
                MaxPing = WindowConfig.ServerHopMaxPing
            })
        end)

        ConfigTab:CreateButton("Clear Blacklist", function()
            BottleLib:ClearHopBlacklist()
            BottleLib:Notify("ServerHop Blacklist cache cleared!")
        end)

        self._IsBuildingConfigTab = false

        -- Execute Auto-Load if enabled
        if autoLoadEnabled and autoLoadTarget then
            task.defer(function()
                if not self.IsClosed then
                    self:LoadConfig(autoLoadTarget)
                end
            end)
        end

        return ConfigTab
    end

    if autoConfig then
        task.defer(function()
            if not WindowObj.IsClosed and not WindowObj._HasBuiltConfigTab then
                WindowObj:BuildConfigTab()
            end
        end)
    end

    -- Check for arrival from previous ServerHop (Region verification & Ping Guard)
    BottleLib:CheckHopArrival(WindowObj, WindowConfig)

    return WindowObj
end

return BottleLib