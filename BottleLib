    function APIObj:CreateSelector(label, options, multiSelect, callback)
        local frame = Instance.new("Frame", targetContainer)
        frame.Size = UDim2.new(1, 0, 0, 0)
        frame.AutomaticSize = Enum.AutomaticSize.Y
        frame.BackgroundColor3 = T.Element
        frame.BackgroundTransparency = 0.35
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = T.Stroke
        stroke.Thickness = 1
        stroke.Transparency = 0.4

        local outerPad = Instance.new("UIPadding", frame)
        outerPad.PaddingTop = UDim.new(0, 8)
        outerPad.PaddingBottom = UDim.new(0, 8)
        outerPad.PaddingLeft = UDim.new(0, 10)
        outerPad.PaddingRight = UDim.new(0, 10)

        local outerLayout = Instance.new("UIListLayout", frame)
        outerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        outerLayout.FillDirection = Enum.FillDirection.Vertical
        outerLayout.Padding = UDim.new(0, 6)

        local headerLbl = Instance.new("TextLabel", frame)
        headerLbl.LayoutOrder = 1
        headerLbl.Size = UDim2.new(1, 0, 0, 16)
        headerLbl.BackgroundTransparency = 1
        headerLbl.Text = label
        headerLbl.TextColor3 = T.SubText
        headerLbl.Font = Enum.Font.GothamBold
        headerLbl.TextSize = 11
        headerLbl.TextXAlignment = Enum.TextXAlignment.Left

        local pillsFrame = Instance.new("Frame", frame)
        pillsFrame.LayoutOrder = 2
        pillsFrame.Size = UDim2.new(1, 0, 0, 0)
        pillsFrame.AutomaticSize = Enum.AutomaticSize.Y
        pillsFrame.BackgroundTransparency = 1

        local pillLayout = Instance.new("UIListLayout", pillsFrame)
        pillLayout.FillDirection = Enum.FillDirection.Horizontal
        pillLayout.Wraps = true
        pillLayout.Padding = UDim.new(0, 6)
        pillLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local selected = {}
        local pillButtons = {}

        local function isSelected(opt) return selected[opt] == true end
        local function getSelectedList()
            local list = {}
            for _, opt in ipairs(options) do
                if selected[opt] then table.insert(list, opt) end
            end
            return list
        end

        local function updatePillVisual(opt)
            local btn = pillButtons[opt]
            if not btn then return end
            if isSelected(opt) then
                TweenService:Create(btn, TweenInfo.new(0.15), {
                    BackgroundColor3 = T.Accent,
                    BackgroundTransparency = 0.1,
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                }):Play()
            else
                TweenService:Create(btn, TweenInfo.new(0.15), {
                    BackgroundColor3 = T.ElemDark,
                    BackgroundTransparency = 0.3,
                    TextColor3 = T.SubText
                }):Play()
            end
        end

        local function createPill(opt, order)
            local btn = Instance.new("TextButton", pillsFrame)
            btn.LayoutOrder = order
            btn.Size = UDim2.new(0, 0, 0, 26)
            btn.AutomaticSize = Enum.AutomaticSize.X
            btn.BackgroundColor3 = T.ElemDark
            btn.BackgroundTransparency = 0.3
            btn.TextColor3 = T.SubText
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 11
            btn.Text = "  " .. opt .. "  "
            btn.AutoButtonColor = false
            Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

            local pStroke = Instance.new("UIStroke", btn)
            pStroke.Color = T.Stroke
            pStroke.Thickness = 1
            pStroke.Transparency = 0.4

            btn.MouseButton1Click:Connect(function()
                if WindowObj.IsClosing or WindowObj.IsClosed then return end
                if multiSelect then
                    selected[opt] = not selected[opt]
                else
                    for k in pairs(selected) do selected[k] = false end
                    selected[opt] = true
                end
                updatePillVisual(opt)
                if not multiSelect then
                    for k in pairs(pillButtons) do updatePillVisual(k) end
                end
                if callback then pcall(callback, getSelectedList(), opt) end
            end)

            pillButtons[opt] = btn
            updatePillVisual(opt)
        end

        for i, opt in ipairs(options) do createPill(opt, i) end

        local SelectorObj = {}
        function SelectorObj:Get() return getSelectedList() end
        function SelectorObj:Set(items, suppressCallback)
            for k in pairs(selected) do selected[k] = false end
            if type(items) == "table" then
                for _, opt in ipairs(items) do selected[opt] = true end
            elseif type(items) == "string" then
                selected[items] = true
            end
            for k in pairs(pillButtons) do updatePillVisual(k) end
            if not suppressCallback and not WindowObj.IsClosing and not WindowObj.IsClosed then
                if callback then pcall(callback, getSelectedList(), nil) end
            end
        end
        function SelectorObj:Refresh(newList)
            for _, btn in pairs(pillButtons) do btn:Destroy() end
            table.clear(pillButtons)
            table.clear(selected)
            options = newList
            for i, opt in ipairs(options) do createPill(opt, i) end
        end
        return SelectorObj
    end

    function APIObj:CreateActionList(config)
        config = config or {}
        local listHeight = config.Height or 180
        local placeholder = config.Placeholder or "Search..."
        local showSearch = (config.Search == true)

        local outerFrame = Instance.new("Frame", targetContainer)
        outerFrame.Size = UDim2.new(1, 0, 0, listHeight + (showSearch and 36 or 0))
        outerFrame.BackgroundColor3 = T.Element
        outerFrame.BackgroundTransparency = 0.35
        Instance.new("UICorner", outerFrame).CornerRadius = UDim.new(0, 8)

        local outerStroke = Instance.new("UIStroke", outerFrame)
        outerStroke.Color = T.Stroke
        outerStroke.Thickness = 1
        outerStroke.Transparency = 0.4

        local outerLayout = Instance.new("UIListLayout", outerFrame)
        outerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        outerLayout.Padding = UDim.new(0, 4)

        local searchBox = nil
        if showSearch then
            local searchContainer = Instance.new("Frame", outerFrame)
            searchContainer.Size = UDim2.new(1, -12, 0, 28)
            searchContainer.Position = UDim2.new(0, 6, 0, 4)
            searchContainer.BackgroundColor3 = T.ElemDark
            searchContainer.BackgroundTransparency = 0.3
            searchContainer.LayoutOrder = 1
            Instance.new("UICorner", searchContainer).CornerRadius = UDim.new(0, 6)

            local sStroke = Instance.new("UIStroke", searchContainer)
            sStroke.Color = T.Stroke
            sStroke.Thickness = 1
            sStroke.Transparency = 0.4

            searchBox = Instance.new("TextBox", searchContainer)
            searchBox.Size = UDim2.new(1, -12, 1, 0)
            searchBox.Position = UDim2.new(0, 8, 0, 0)
            searchBox.BackgroundTransparency = 1
            searchBox.PlaceholderText = "🔍 " .. placeholder
            searchBox.PlaceholderColor3 = T.SubText
            searchBox.TextColor3 = T.Text
            searchBox.Font = Enum.Font.GothamMedium
            searchBox.TextSize = 11
            searchBox.TextXAlignment = Enum.TextXAlignment.Left
        end

        local scrollFrame = Instance.new("ScrollingFrame", outerFrame)
        scrollFrame.Size = UDim2.new(1, -8, 1, showSearch and -38 or -8)
        scrollFrame.Position = UDim2.new(0, 4, 0, showSearch and 0 or 4)
        scrollFrame.BackgroundTransparency = 1
        scrollFrame.BorderSizePixel = 0
        scrollFrame.ScrollBarThickness = 3
        scrollFrame.ScrollBarImageColor3 = T.Accent
        scrollFrame.LayoutOrder = 2

        local listLayout = Instance.new("UIListLayout", scrollFrame)
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 4)

        local items = {}

        local function refreshFilter()
            local filter = searchBox and string.lower(searchBox.Text) or ""
            local count = 0
            for _, it in pairs(items) do
                local title = string.lower(it.Data.Title or "")
                local sub = string.lower(it.Data.Subtitle or "")
                local visible = (filter == "" or string.find(title, filter, 1, true) or string.find(sub, filter, 1, true))
                it.Frame.Visible = visible
                if visible then count = count + 1 end
            end
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 36)
        end

        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(refreshFilter)
        end

        local ActionListObj = {}

        function ActionListObj:AddItem(id, itemData)
            if items[id] then
                self:UpdateItem(id, itemData)
                return
            end

            local rowConns = {}
            local row = Instance.new("Frame", scrollFrame)
            row.Size = UDim2.new(1, -4, 0, 32)
            row.BackgroundColor3 = T.ElemDark
            row.BackgroundTransparency = 0.35
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            local rStroke = Instance.new("UIStroke", row)
            rStroke.Color = T.Stroke
            rStroke.Thickness = 1
            rStroke.Transparency = 0.4

            local toggleBtn = Instance.new("TextButton", row)
            toggleBtn.Size = UDim2.new(0, 24, 1, 0)
            toggleBtn.BackgroundTransparency = 1
            toggleBtn.Text = ""

            local dot = Instance.new("Frame", toggleBtn)
            dot.Size = UDim2.new(0, 10, 0, 10)
            dot.Position = UDim2.new(0.5, -5, 0.5, -5)
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local isChecked = itemData.Checked or false
            dot.BackgroundColor3 = isChecked and T.Accent or Color3.fromRGB(50, 50, 55)

            local infoFrame = Instance.new("Frame", row)
            infoFrame.Size = UDim2.new(0.55, -28, 1, 0)
            infoFrame.Position = UDim2.new(0, 26, 0, 0)
            infoFrame.BackgroundTransparency = 1

            local titleLbl = Instance.new("TextButton", infoFrame)
            titleLbl.Size = UDim2.new(1, 0, itemData.Subtitle and 0.55 or 1, 0)
            titleLbl.BackgroundTransparency = 1
            titleLbl.Text = itemData.Title or tostring(id)
            titleLbl.TextColor3 = T.Text
            titleLbl.Font = Enum.Font.GothamSemibold
            titleLbl.TextSize = 11
            titleLbl.TextXAlignment = Enum.TextXAlignment.Left
            titleLbl.TextTruncate = Enum.TextTruncate.AtEnd

            local subLbl = nil
            if itemData.Subtitle then
                subLbl = Instance.new("TextLabel", infoFrame)
                subLbl.Size = UDim2.new(1, 0, 0.45, 0)
                subLbl.Position = UDim2.new(0, 0, 0.55, -2)
                subLbl.BackgroundTransparency = 1
                subLbl.Text = itemData.Subtitle
                subLbl.TextColor3 = T.SubText
                subLbl.Font = Enum.Font.Gotham
                subLbl.TextSize = 9
                subLbl.TextXAlignment = Enum.TextXAlignment.Left
                subLbl.TextTruncate = Enum.TextTruncate.AtEnd
            end

            local isRowUpdating = false
            local function setRowChecked(st, suppressCallback)
                if isRowUpdating then return end
                if isChecked == st then return end
                isRowUpdating = true
                isChecked = st
                TweenService:Create(dot, TweenInfo.new(0.15), {
                    BackgroundColor3 = isChecked and T.Accent or Color3.fromRGB(50, 50, 55)
                }):Play()

                if not suppressCallback and not WindowObj.IsClosing and not WindowObj.IsClosed then
                    if itemData.OnToggle then
                        pcall(itemData.OnToggle, isChecked, id)
                    end
                end
                isRowUpdating = false
            end

            local cTog1 = toggleBtn.MouseButton1Click:Connect(function()
                if WindowObj.IsClosing or WindowObj.IsClosed then return end
                setRowChecked(not isChecked, false)
            end)
            local cTog2 = titleLbl.MouseButton1Click:Connect(function()
                if WindowObj.IsClosing or WindowObj.IsClosed then return end
                setRowChecked(not isChecked, false)
            end)
            table.insert(rowConns, cTog1)
            table.insert(rowConns, cTog2)

            local rightBtns = Instance.new("Frame", row)
            rightBtns.Size = UDim2.new(0.42, 0, 1, 0)
            rightBtns.Position = UDim2.new(0.58, 0, 0, 0)
            rightBtns.BackgroundTransparency = 1

            local rLayout = Instance.new("UIListLayout", rightBtns)
            rLayout.FillDirection = Enum.FillDirection.Horizontal
            rLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
            rLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            rLayout.Padding = UDim.new(0, 4)

            local pad = Instance.new("UIPadding", rightBtns)
            pad.PaddingRight = UDim.new(0, 6)

            if itemData.Buttons then
                for _, bConfig in ipairs(itemData.Buttons) do
                    local actBtn = Instance.new("TextButton", rightBtns)
                    actBtn.Size = UDim2.new(0, 24, 0, 22)
                    actBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
                    actBtn.BackgroundTransparency = 0.3
                    actBtn.Text = bConfig.Icon or "⚡"
                    actBtn.TextColor3 = T.Text
                    actBtn.Font = Enum.Font.GothamBold
                    actBtn.TextSize = 11
                    actBtn.AutoButtonColor = false
                    Instance.new("UICorner", actBtn).CornerRadius = UDim.new(0, 4)

                    local bStroke = Instance.new("UIStroke", actBtn)
                    bStroke.Color = T.Stroke
                    bStroke.Thickness = 1
                    bStroke.Transparency = 0.4

                    local cBtn = actBtn.MouseButton1Click:Connect(function()
                        if WindowObj.IsClosing or WindowObj.IsClosed then return end
                        local t1 = TweenService:Create(actBtn, TweenInfo.new(0.1), {BackgroundColor3 = T.Accent, BackgroundTransparency = 0.1})
                        local t2 = TweenService:Create(actBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 24, 24), BackgroundTransparency = 0.3})
                        t1:Play()
                        t1.Completed:Connect(function() t2:Play() end)
                        if bConfig.OnClick then pcall(bConfig.OnClick, id, itemData) end
                    end)
                    table.insert(rowConns, cBtn)
                end
            end

            items[id] = {
                Frame = row,
                Dot = dot,
                TitleLabel = titleLbl,
                SubLabel = subLbl,
                Data = itemData,
                Connections = rowConns,
                GetChecked = function() return isChecked end,
                SetChecked = setRowChecked
            }
            refreshFilter()
        end

        function ActionListObj:RemoveItem(id)
            local item = items[id]
            if item then
                for _, c in ipairs(item.Connections or {}) do
                    if c and c.Disconnect then pcall(function() c:Disconnect() end) end
                end
                table.clear(item.Connections)
                item.Frame:Destroy()
                items[id] = nil
                refreshFilter()
            end
        end

        function ActionListObj:UpdateItem(id, itemData)
            if items[id] then
                items[id].Data = itemData
                items[id].TitleLabel.Text = itemData.Title or tostring(id)
                if items[id].SubLabel and itemData.Subtitle then
                    items[id].SubLabel.Text = itemData.Subtitle
                end
                if itemData.Checked ~= nil then
                    items[id].SetChecked(itemData.Checked, true)
                end
                refreshFilter()
            end
        end

        function ActionListObj:Clear()
            for _, it in pairs(items) do
                for _, c in ipairs(it.Connections or {}) do
                    if c and c.Disconnect then pcall(function() c:Disconnect() end) end
                end
                table.clear(it.Connections)
                it.Frame:Destroy()
            end
            table.clear(items)
            refreshFilter()
        end

        return ActionListObj
    end

