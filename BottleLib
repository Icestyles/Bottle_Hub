local function BindUIElements(APIObj, targetContainer, T, WindowObj, ScreenGui, GlobalOverlayClose, _depth)
    _depth = _depth or 0

    function APIObj:CreateSection(text)
        local l = Instance.new("TextLabel", targetContainer)
        l.Size = UDim2.new(1, 0, 0, 22)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = T.Accent
        l.Font = Enum.Font.GothamBlack
        l.TextSize = 11
        l.TextXAlignment = Enum.TextXAlignment.Left
    end

    function APIObj:CreateLabel(text)
        local l = Instance.new("TextLabel", targetContainer)
        l.Size = UDim2.new(1, 0, 0, 22)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = T.SubText
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 11
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextWrapped = true

        local LblObj = {}
        function LblObj:Set(t) l.Text = t end
        function LblObj:SetText(t) l.Text = t end
        return LblObj
    end

    function APIObj:CreateSeparator()
        local f = Instance.new("Frame", targetContainer)
        f.Size = UDim2.new(1, 0, 0, 1)
        f.BackgroundColor3 = T.Stroke
        f.BackgroundTransparency = 0.4
        f.BorderSizePixel = 0
    end

    function APIObj:CreateButton(text, callback)
        local btn = Instance.new("TextButton", targetContainer)
        btn.Size = UDim2.new(1, 0, 0, 32)
        btn.BackgroundColor3 = T.Element
        btn.BackgroundTransparency = 0.35
        btn.Text = text
        btn.TextColor3 = T.Text
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 12
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = T.Stroke
        stroke.Thickness = 1
        stroke.Transparency = 0.4

        btn.MouseButton1Click:Connect(function()
            if WindowObj.IsClosing or WindowObj.IsClosed then return end
            local t1 = TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = T.Accent, BackgroundTransparency = 0.1})
            local t2 = TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = T.Element, BackgroundTransparency = 0.35})
            t1:Play()
            t1.Completed:Connect(function() t2:Play() end)
            if callback then pcall(callback, btn) end
        end)

        local BtnObj = {}
        function BtnObj:Set(t) btn.Text = t end
        return BtnObj
    end

    function APIObj:CreateToggle(label, init, callback)
        local btn = Instance.new("TextButton", targetContainer)
        btn.Size = UDim2.new(1, 0, 0, 32)
        btn.BackgroundColor3 = T.Element
        btn.BackgroundTransparency = 0.35
        btn.Text = "    " .. label
        btn.TextColor3 = T.Text
