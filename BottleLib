            local text = Input.Text
            if isNumberOnly then
                local num = tonumber(text)
                if num then
                    if callback then pcall(callback, num) end
                else
                    Input.Text = ""
                end
            else
                if callback then pcall(callback, text) end
            end
        end)

        local InputObj = {}
        function InputObj:Set(val, suppressCallback)
            local strVal = tostring(val or "")
            if Input.Text == strVal then return end
            Input.Text = strVal
            if not suppressCallback and not WindowObj.IsClosing and not WindowObj.IsClosed then
                if callback then
                    pcall(callback, isNumberOnly and tonumber(strVal) or strVal)
                end
