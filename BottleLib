    function APIObj:CreateKeybindBox(label, defaultKey, callback)
        local frame = Instance.new("Frame", targetContainer)
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = T.Element
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

        local l = Instance.new("TextLabel", frame)
        l.Size = UDim2.new(0.5, 0, 1, 0)
        l.Position = UDim2.new(0.02, 0, 0, 0)
        l.BackgroundTransparency = 1
        l.Text = label
        l.TextColor3 = T.SubText
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 10
        l.TextXAlignment = Enum.TextXAlignment.Left

        local b = Instance.new("TextButton", frame)
        b.Size = UDim2.new(0.3, 0, 0.65, 0)
        b.Position = UDim2.new(0.68, 0, 0.175, 0)
        b.BackgroundColor3 = T.ElemDark
        b.TextColor3 = T.Accent
        b.Font = Enum.Font.GothamBold
        b.Text = (defaultKey and typeof(defaultKey) == "EnumItem") and defaultKey.Name or "NONE"
        b.AutoButtonColor = false
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

        local binding = false
        local conn = nil

        b.MouseButton1Click:Connect(function()
            binding = true
            b.Text = "..."
            if conn then conn:Disconnect() end
            conn = UserInputService.InputBegan:Connect(function(input)
                if binding and input.UserInputType == Enum.UserInputType.Keyboard then
                    binding = false
                    if conn then conn:Disconnect(); conn = nil end
                    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                        b.Text = "NONE"
                        if callback then callback(nil) end
                    else
                        b.Text = input.KeyCode.Name
                        if callback then callback(input.KeyCode) end
                    end
                end
            end)
        end)
    end

